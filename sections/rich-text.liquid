<section {% render 'section-attrs', s: section.settings, id: section.id %}>
  <div class="section__inner">

  <div class="stack-lg" style="max-width: 68ch; {% if section.settings.align == 'center' %}margin-inline: auto; text-align: center;{% endif %}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          <span class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {%- when 'heading' -%}
          <h2 {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
        {%- when 'text' -%}
          <div class="rte lede" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'rule' -%}
          <hr class="rule{% unless settings.rule_ornament == 'none' %} rule--{{ settings.rule_ornament }}{% endunless %}" {{ block.shopify_attributes }}>
        {%- when 'button' -%}
          <div {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '#' }}" class="btn btn--{{ block.settings.style }}">{{ block.settings.label }}</a>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centred"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Follows the active design preset.",
      "options": [
        {
          "value": "default",
          "label": "Page background"
        },
        {
          "value": "surface",
          "label": "Raised surface"
        },
        {
          "value": "raised",
          "label": "Raised (higher)"
        },
        {
          "value": "brand",
          "label": "Brand"
        },
        {
          "value": "accent",
          "label": "Accent tint"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full bleed"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Our story"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Made for rooms with a darker disposition"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Every piece is chosen for weight, patina and the way it holds low light.</p>"
        }
      ]
    },
    {
      "type": "rule",
      "name": "Divider"
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Read more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "gold",
              "label": "Gold outline"
            },
            {
              "value": "ghost",
              "label": "Ghost"
            }
          ],
          "default": "gold"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [
        {
          "type": "eyebrow"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        }
      ]
    }
  ]
}
{% endschema %}
