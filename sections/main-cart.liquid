{%- comment -%}
  Full cart page. Always present even when the drawer is enabled — customers
  land here from /cart links, email receipts and browser autocomplete.
{%- endcomment -%}

<div class="section" data-section-id="{{ section.id }}">
  <div class="page-width">
    <h1 style="margin-bottom: var(--sp-7);">{{ 'sections.cart.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <div class="empty-state">
        <p class="h3">{{ 'sections.cart.empty' | t }}</p>
        <p class="text-muted">{{ 'sections.cart.empty_hint' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--gold">
          {{ 'general.continue_shopping' | t }}
        </a>
      </div>
    {%- else -%}

      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div style="display: grid; gap: var(--sp-8); align-items: start;" class="cart-layout">

          <div>
            <div role="list">
              {%- for item in cart.items -%}
                <div class="cart-item" role="listitem">
                  <a href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                    {%- if item.image -%}
                      {{ item.image | image_url: width: 200 | image_tag:
                         loading: 'lazy', widths: '84,168,252', sizes: '84px',
                         alt: item.title, class: 'cart-item__img' }}
                    {%- endif -%}
                  </a>

                  <div>
                    <h2 class="cart-item__title"><a href="{{ item.url }}">{{ item.product.title }}</a></h2>

                    {%- unless item.product.has_only_default_variant -%}
                      <p class="cart-item__variant">{{ item.variant.title }}</p>
                    {%- endunless -%}

                    {%- for property in item.properties -%}
                      {%- assign prop_prefix = property.first | slice: 0, 1 -%}
                      {%- unless property.last == blank or prop_prefix == '_' -%}
                        <p class="cart-item__variant">{{ property.first }}: {{ property.last }}</p>
                      {%- endunless -%}
                    {%- endfor -%}

                    {%- for discount in item.line_level_discount_allocations -%}
                      <p class="cart-item__variant" style="color: var(--color-accent-text);">
                        {{ discount.discount_application.title }} (&minus;{{ discount.amount | money }})
                      </p>
                    {%- endfor -%}

                    <div class="cart-item__row">
                      <quantity-input class="qty">
                        <button type="button" class="qty__btn" data-qty-step="-1"
                                aria-label="{{ 'sections.cart.decrease' | t }}">
                          {% render 'icon', name: 'minus', size: 14 %}
                        </button>
                        <input type="number"
                               class="qty__input"
                               name="updates[]"
                               value="{{ item.quantity }}"
                               min="0"
                               aria-label="{{ 'sections.cart.quantity' | t }}">
                        <button type="button" class="qty__btn" data-qty-step="1"
                                aria-label="{{ 'sections.cart.increase' | t }}">
                          {% render 'icon', name: 'plus', size: 14 %}
                        </button>
                      </quantity-input>

                      <div>
                        {%- if item.original_line_price != item.final_line_price -%}
                          <s class="price__compare">{{ item.original_line_price | money }}</s>
                        {%- endif -%}
                        <span class="price__regular">{{ item.final_line_price | money }}</span>
                      </div>
                    </div>

                    <div class="cart-item__row">
                      <a href="{{ item.url_to_remove }}" class="cart-item__remove">
                        {{ 'sections.cart.remove' | t }}
                      </a>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>

            <div style="margin-top: var(--sp-6);">
              <button type="submit" name="update" class="btn btn--ghost btn--sm">
                {{ 'sections.cart.update' | t }}
              </button>
            </div>
          </div>

          <aside style="background: var(--color-surface); border: 1px solid var(--color-line); padding: var(--sp-6);">
            {%- if settings.cart_show_note -%}
              <label class="field" style="margin-bottom: var(--sp-5);">
                <span class="field__label">{{ 'sections.cart.note' | t }}</span>
                <textarea name="note" class="textarea"
                          placeholder="{{ 'sections.cart.note_placeholder' | t }}">{{ cart.note }}</textarea>
              </label>
            {%- endif -%}

            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="cart-total">
                <span class="cart-total__label">{{ discount.title }}</span>
                <span class="price__regular">&minus;{{ discount.total_allocated_amount | money }}</span>
              </div>
            {%- endfor -%}

            {%- if settings.ship_show_estimate or settings.ship_show_returns -%}
              <ul class="cart-assurances" role="list">
                {%- if settings.ship_show_estimate and settings.ship_estimate_text != blank -%}
                  <li>{% render 'icon', name: 'truck', size: 15 %}{{ settings.ship_estimate_text }}</li>
                {%- endif -%}
                {%- if settings.ship_show_returns and settings.ship_returns_text != blank -%}
                  <li>{% render 'icon', name: 'shield', size: 15 %}{{ settings.ship_returns_text }}</li>
                {%- endif -%}
              </ul>
            {%- endif -%}

            <div class="cart-total">
              <span class="cart-total__label">{{ 'sections.cart.subtotal' | t }}</span>
              <span class="cart-total__value">{{ cart.total_price | money_with_currency }}</span>
            </div>

            {%- if settings.checkout_terms_required -%}
              <label class="facet__option" style="margin-bottom: var(--sp-4);">
                <input type="checkbox" required data-terms-gate>
                <span>
                  {%- if settings.checkout_terms_link != blank -%}
                    {{ 'sections.cart.terms_agree_linked' | t: url: settings.checkout_terms_link }}
                  {%- else -%}
                    {{ 'sections.cart.terms_agree' | t }}
                  {%- endif -%}
                </span>
              </label>
            {%- endif -%}
            <button type="submit" name="checkout" class="btn btn--primary btn--full btn--lg">
              {{ 'sections.cart.checkout' | t }}
            </button>

            <p class="cart-note">{{ 'sections.cart.taxes_note' | t }}</p>

            {%- if settings.checkout_dynamic_buttons and additional_checkout_buttons -%}
              <div style="margin-top: var(--sp-4);">{{ content_for_additional_checkout_buttons }}</div>
            {%- endif -%}

            {%- if settings.checkout_show_payment_icons and shop.enabled_payment_types.size > 0 -%}
              <div class="payment-icons" style="justify-content: center; margin-top: var(--sp-4);"
                   role="list" aria-label="{{ 'sections.footer.payment_methods' | t }}">
                {%- for type in shop.enabled_payment_types -%}
                  <span role="listitem">{{ type | payment_type_svg_tag: class: 'payment-icon' }}</span>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </aside>
        </div>
      </form>
    {%- endif -%}
  </div>
</div>

<style>
  @media (min-width: 990px) {
    .cart-layout { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); }
    .cart-layout aside { position: sticky; top: calc(var(--header-h) + var(--sp-5)); }
  }
</style>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
