<style>
  .lookbook-section .section-title {
    text-align: center;
    margin-bottom: var(--sp-2, 0.5rem);
  }

  .lookbook-section .section-subtitle {
    text-align: center;
    color: var(--color-text-muted);
    margin: 0 auto var(--sp-6, 2rem);
    max-width: 60ch;
  }

  .lookbook-container {
    position: relative;
  }

  .lookbook-frame {
    position: relative;
  }

  .lookbook-image {
    width: 100%;
    display: block;
    border-radius: var(--radius-md, 8px);
    border: 1px solid var(--color-line);
  }

  .hotspot {
    position: absolute;
    width: var(--hotspot-size);
    height: var(--hotspot-size);
    background-color: var(--hotspot-fill);
    border: 2px solid var(--hotspot-ring);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .lookbook-frame--pulse .hotspot {
    animation: hotspot-pulse 2.4s ease-out infinite;
  }

  @keyframes hotspot-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--hotspot-fill) 45%, transparent); }
    70% { box-shadow: 0 0 0 12px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .hotspot:hover,
  .hotspot:focus-visible {
    transform: translate(-50%, -50%) scale(1.15);
    box-shadow: 0 0 15px var(--hotspot-fill);
    animation: none;
  }

  .hotspot .hotspot-label {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm, 4px);
    padding: 6px 10px;
    font-family: var(--font-body);
    font-size: 12px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    pointer-events: none;
    z-index: 3;
  }

  .hotspot:hover .hotspot-label,
  .hotspot:focus-visible .hotspot-label {
    opacity: 1;
    visibility: visible;
  }
</style>

{%- liquid
  if section.settings.hotspot_follow_theme
    assign hotspot_fill = 'var(--color-accent)'
    assign hotspot_ring = 'var(--color-brand)'
  else
    assign hotspot_fill = section.settings.hotspot_color
    assign hotspot_ring = section.settings.hotspot_ring_color
  endif
-%}
<section {% render 'section-attrs', s: section.settings, id: section.id, extra: 'lookbook-section' %}>
  <div class="section__inner">
  {% if section.settings.heading != blank %}
    <h2 class="section-title">{{ section.settings.heading }}</h2>
  {% endif %}
  {% if section.settings.subheading != blank %}
    <p class="section-subtitle">{{ section.settings.subheading }}</p>
  {% endif %}

  <div
    class="lookbook-container"
    style="--hotspot-size: {{ section.settings.hotspot_size }}px; --hotspot-fill: {{ hotspot_fill }}; --hotspot-ring: {{ hotspot_ring }};"
  >
    <div class="lookbook-frame{% if section.settings.pulse %} lookbook-frame--pulse{% endif %}">
      {% if section.settings.room_image != blank %}
        {%- assign lookbook_alt = section.settings.heading | default: 'Shoppable room' -%}
        {{ section.settings.room_image | image_url: width: 1600 | image_tag: class: 'lookbook-image', loading: 'lazy', alt: lookbook_alt }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'lookbook-image' }}
      {% endif %}

      {% for block in section.blocks %}
        {% if block.settings.product != blank %}
          <a
            href="{{ block.settings.product.url }}"
            class="hotspot"
            style="top: {{ block.settings.top_position }}%; left: {{ block.settings.left_position }}%;"
            aria-label="Shop {{ block.settings.product.title }}"
            {{ block.shopify_attributes }}
          >
            {% if section.settings.show_labels %}
              <span class="hotspot-label">
                {%- if block.settings.label != blank -%}
                  {{ block.settings.label }}
                {%- else -%}
                  {{ block.settings.product.title }}
                {%- endif -%}
                {%- if section.settings.show_label_price %} &middot; {{ block.settings.product.price | money }}{% endif -%}
              </span>
            {% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  </div>
</section>

{% schema %}
{
  "name": "Shoppable lookbook",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the Look"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "image_picker",
      "id": "room_image",
      "label": "Room lifestyle image"
    },
    {
      "type": "header",
      "content": "Hotspots"
    },
    {
      "type": "checkbox",
      "id": "hotspot_follow_theme",
      "label": "Match theme colours",
      "info": "Uses the accent and brand colours, so hotspots re-tint with design presets. Untick to pick custom colours below.",
      "default": true
    },
    {
      "type": "color",
      "id": "hotspot_color",
      "label": "Custom hotspot colour",
      "default": "#c6a15b"
    },
    {
      "type": "color",
      "id": "hotspot_ring_color",
      "label": "Custom ring colour",
      "default": "#2d6a40"
    },
    {
      "type": "range",
      "id": "hotspot_size",
      "label": "Hotspot size",
      "min": 16,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "pulse",
      "label": "Pulse animation",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "Show hover labels",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_label_price",
      "label": "Show price in label",
      "default": true
    },
    { "type": "header", "content": "Section layout" },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme",
      "info": "Follows the active design preset.",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "surface", "label": "Raised surface" },
        { "value": "raised", "label": "Raised (higher)" },
        { "value": "brand", "label": "Brand" },
        { "value": "accent", "label": "Accent tint" },
        { "value": "inverse", "label": "Inverse" }
      ], "default": "default" },
    { "type": "select", "id": "section_width", "label": "Content width",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "page", "label": "Page" },
        { "value": "wide", "label": "Wide" },
        { "value": "full", "label": "Full bleed" }
      ], "default": "page" },
    { "type": "range", "id": "padding_top", "label": "Top padding",
      "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding",
      "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Product hotspot",
      "limit": 5,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Custom label",
          "info": "Falls back to the product title."
        },
        {
          "type": "range",
          "id": "top_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Top position",
          "default": 50
        },
        {
          "type": "range",
          "id": "left_position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Left position",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable lookbook",
      "blocks": [
        {
          "type": "hotspot"
        }
      ]
    }
  ]
}
{% endschema %}
