<section {% render 'section-attrs', s: section.settings, id: section.id %}>
  <div class="section__inner">
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
    </div>

    <div class="grid grid--{{ section.settings.columns }} grid--keep-2">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = collections[block.settings.collection]
          comment
            image_tag escapes attributes itself. A filter placed after its last
            named argument applies to the whole <img> tag instead, which
            renders the markup as visible text — so build the alt first.
          endcomment
          assign alt_text = coll.title | default: block.settings.heading | default: 'Collection'
        -%}
        <a href="{{ coll.url | default: '#' }}" class="tile reveal" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}
            {{ block.settings.image | image_url: width: 900 | image_tag:
               loading: 'lazy', widths: '300,450,600,900',
               sizes: '(min-width: 990px) 30vw, 45vw',
               alt: alt_text }}
          {%- elsif coll.featured_image -%}
            {{ coll.featured_image | image_url: width: 900 | image_tag:
               loading: 'lazy', widths: '300,450,600,900',
               sizes: '(min-width: 990px) 30vw, 45vw',
               alt: alt_text }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}

          <div class="tile__caption">
            <p class="tile__name">{{ block.settings.heading | default: coll.title | default: 'Collection' }}</p>
            {%- if block.settings.show_count and coll != blank -%}
              <p class="tile__count">{{ 'sections.collection.item_count' | t: count: coll.products_count }}</p>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Browse"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by room"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "3"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Follows the active design preset.",
      "options": [
        {
          "value": "default",
          "label": "Page background"
        },
        {
          "value": "surface",
          "label": "Raised surface"
        },
        {
          "value": "raised",
          "label": "Raised (higher)"
        },
        {
          "value": "brand",
          "label": "Brand"
        },
        {
          "value": "accent",
          "label": "Accent tint"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full bleed"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Falls back to the collection image."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Label override"
        },
        {
          "type": "checkbox",
          "id": "show_count",
          "label": "Show product count",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
