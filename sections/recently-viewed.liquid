<section {% render 'section-attrs', s: section.settings, id: section.id %}>
  <div class="section__inner">
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: '#' }}" class="link-quiet">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%}
    Populated by theme.js from localStorage, so it is per-visitor and needs no
    app or customer account. Hidden entirely when there is no history.
  {%- endcomment -%}
  <recently-viewed data-limit="{{ section.settings.count }}" hidden>
    <div class="grid grid--{{ section.settings.columns }} grid--keep-2" data-recent-grid></div>
  </recently-viewed>
  </div>
</section>

{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Products",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "4"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Follows the active design preset.",
      "options": [
        {
          "value": "default",
          "label": "Page background"
        },
        {
          "value": "surface",
          "label": "Raised surface"
        },
        {
          "value": "raised",
          "label": "Raised (higher)"
        },
        {
          "value": "brand",
          "label": "Brand"
        },
        {
          "value": "accent",
          "label": "Accent tint"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full bleed"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Recently viewed"
    }
  ]
}
{% endschema %}
