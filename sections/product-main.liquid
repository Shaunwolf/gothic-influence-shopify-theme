<style>
  .product {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--sp-8, 3rem);
    max-width: var(--page-max, 1440px);
    margin: 0 auto;
    padding: var(--sp-8, 3rem) var(--sp-6, 2rem);
  }

  @media (max-width: 860px) {
    .product {
      grid-template-columns: 1fr;
    }
  }

  .product__info--sticky {
    position: sticky;
    top: calc(var(--header-h, 80px) + var(--sp-4, 1rem));
    align-self: start;
  }

  .product__title {
    font-size: 2.5rem;
    margin-bottom: var(--sp-3, 0.75rem);
  }

  .product__price {
    margin-bottom: var(--sp-4, 1rem);
  }

  .product__inventory {
    margin-bottom: var(--sp-4, 1rem);
  }

  .product__description {
    margin-bottom: var(--sp-5, 1.5rem);
  }

  .product__eyebrow {
    display: block;
    color: var(--color-accent-text);
    font-family: var(--font-body);
    font-size: var(--fs-sm, 0.85rem);
    letter-spacing: var(--track-caps, 0.18em);
    text-transform: uppercase;
    margin-bottom: var(--sp-3, 0.75rem);
  }

  .product__buy-row {
    display: flex;
    gap: var(--sp-4, 1rem);
    align-items: stretch;
    margin: var(--sp-5, 1.5rem) 0;
  }

  .product .accordion {
    margin-top: var(--sp-5, 1.5rem);
  }
</style>

{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="product" data-section-id="{{ section.id }}">
  <div class="product__gallery">
    {% render 'product-media', product: product %}
  </div>

  <div class="product__info{% if section.settings.sticky_info %} product__info--sticky{% endif %}">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'text' %}
          {% if block.settings.text != blank %}
            {% if block.settings.style == 'eyebrow' %}
              <span class="product__eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
            {% else %}
              <p {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {% endif %}
          {% endif %}

        {% when 'title' %}
          <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

        {% when 'price' %}
          <div class="product__price" {{ block.shopify_attributes }}>
            {% render 'price', target: current_variant %}
          </div>

        {% when 'inventory' %}
          <div class="product__inventory" data-inventory-block {{ block.shopify_attributes }}>
            {%- if current_variant.available -%}
              {%- if current_variant.inventory_management != blank and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= block.settings.low_stock_threshold -%}
                <span class="eyebrow">Only {{ current_variant.inventory_quantity }} left</span>
              {%- endif -%}
            {%- else -%}
              <span class="eyebrow eyebrow--muted">{{ 'products.product.sold_out' | t }}</span>
            {%- endif -%}
          </div>

        {% when 'variant_picker' %}
          {% unless product.has_only_default_variant %}
            <variant-picker data-url="{{ product.url }}" {{ block.shopify_attributes }}>
              <script type="application/json" data-variant-json>
                {{ product.variants | json }}
              </script>
              {% for option in product.options_with_values %}
                <fieldset class="option">
                  <legend class="option__head">
                    <span class="option__name">{{ option.name }}</span>
                    <span class="option__value" data-option-selected>{{ option.selected_value }}</span>
                  </legend>
                  <div class="option__list">
                    {% for value in option.values %}
                      <label class="option__label">
                        <input
                          type="radio"
                          class="option__input"
                          name="options[{{ option.name | escape }}]"
                          value="{{ value | escape }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <span>{{ value }}</span>
                      </label>
                    {% endfor %}
                  </div>
                </fieldset>
              {% endfor %}
            </variant-picker>
          {% endunless %}

        {% when 'buy_buttons' %}
          <product-form {{ block.shopify_attributes }}>
            {% form 'product', product %}
              <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
              <div class="product__buy-row" data-atc-anchor>
                {% if block.settings.show_quantity %}
                  <quantity-input class="qty">
                    <button type="button" class="qty__btn" data-qty-step="-1" aria-label="Decrease quantity">&minus;</button>
                    <input
                      type="number"
                      class="qty__input"
                      name="quantity"
                      value="1"
                      min="1"
                      aria-label="{{ 'products.product.quantity' | t }}"
                    >
                    <button type="button" class="qty__btn" data-qty-step="1" aria-label="Increase quantity">+</button>
                  </quantity-input>
                {% endif %}
                <button
                  type="submit"
                  class="btn btn--primary btn--full"
                  data-add-button
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  <span data-add-label>
                    {%- if current_variant.available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                </button>
              </div>
            {% endform %}
          </product-form>

        {% when 'description' %}
          {% if product.description != blank %}
            <div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
          {% endif %}

        {% when 'collapsible_tab' %}
          <div class="accordion" {{ block.shopify_attributes }}>
            <details class="accordion__item" {% if block.settings.open_default %}open{% endif %}>
              <summary class="accordion__summary">
                {{ block.settings.heading }}
                <span class="accordion__icon" aria-hidden="true"></span>
              </summary>
              <div class="accordion__content rte">{{ block.settings.content }}</div>
            </details>
          </div>

        {% when 'custom_liquid' %}
          <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
      {% endcase %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Product main",
  "settings": [
    {
      "type": "checkbox",
      "id": "sticky_info",
      "label": "Sticky product details",
      "info": "Keeps the buy column in view while the gallery scrolls.",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Luxury home decor"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "eyebrow", "label": "Eyebrow" },
            { "value": "body", "label": "Body" }
          ],
          "default": "eyebrow"
        }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "inventory",
      "name": "Inventory status",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "low_stock_threshold",
          "label": "Low-stock warning below",
          "min": 1,
          "max": 20,
          "step": 1,
          "default": 10
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_quantity",
          "label": "Show quantity selector",
          "default": true
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Materials & care"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "checkbox",
          "id": "open_default",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid"
        }
      ]
    }
  ]
}
{% endschema %}
