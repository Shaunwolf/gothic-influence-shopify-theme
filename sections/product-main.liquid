<style>
  .product__layout {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--sp-8, 3rem);
  }

  @media (max-width: 860px) {
    .product__layout {
      grid-template-columns: 1fr;
    }
  }

  .product__info--sticky {
    position: sticky;
    top: calc(var(--header-h, 80px) + var(--sp-4, 1rem));
    align-self: start;
  }

  .product__title {
    font-size: 2.5rem;
    margin-bottom: var(--sp-3, 0.75rem);
  }

  .product__price {
    margin-bottom: var(--sp-4, 1rem);
  }

  .product__inventory {
    margin-bottom: var(--sp-4, 1rem);
  }

  .product__description {
    margin-bottom: var(--sp-5, 1.5rem);
  }

  .product__eyebrow {
    display: block;
    color: var(--color-accent-text);
    font-family: var(--font-body);
    font-size: var(--fs-sm, 0.85rem);
    letter-spacing: var(--track-caps, 0.18em);
    text-transform: uppercase;
    margin-bottom: var(--sp-3, 0.75rem);
  }

  .product__buy-row {
    display: flex;
    gap: var(--sp-4, 1rem);
    align-items: stretch;
    margin: var(--sp-5, 1.5rem) 0;
  }

  .product .accordion {
    margin-top: var(--sp-5, 1.5rem);
  }

  .product__assurances {
    list-style: none;
    margin: var(--sp-5, 1.5rem) 0 0;
    padding: var(--sp-4, 1rem) 0 0;
    border-top: 1px solid var(--color-line);
    display: grid;
    gap: var(--sp-2, 0.5rem);
  }

  .product__assurances li {
    display: flex;
    align-items: center;
    gap: var(--sp-2, 0.5rem);
    color: var(--color-text-muted);
    font-size: var(--fs-sm, 0.85rem);
  }

  .product__assurances svg {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .product__specs {
    margin: var(--sp-5, 1.5rem) 0;
  }

  .specs-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm, 0.85rem);
  }

  .specs-table th,
  .specs-table td {
    text-align: left;
    padding: var(--sp-3, 0.75rem) var(--sp-4, 1rem);
    border-bottom: 1px solid var(--color-line);
  }

  .specs-table th {
    font-weight: var(--fw-medium, 500);
    color: var(--color-text-muted);
    width: 40%;
  }

  .product__reviews {
    margin: var(--sp-5, 1.5rem) 0;
  }

  .product__rating {
    display: flex;
    align-items: center;
    gap: var(--sp-2, 0.5rem);
  }

  .product__rating .star {
    color: var(--color-line);
    font-size: 1.1rem;
  }

  .product__rating .star--filled {
    color: var(--color-accent);
  }

  .product__rating-count {
    color: var(--color-text-muted);
    font-size: var(--fs-sm, 0.85rem);
  }
</style>

{%- assign current_variant = product.selected_or_first_available_variant -%}

<section {% render 'section-attrs', s: section.settings, id: section.id, extra: 'product' %}>
  <div class="section__inner">
  <div class="product__layout">
  <div class="product__gallery">
    {% render 'product-media', product: product, thumbs: section.settings.media_layout %}
  </div>

  <div class="product__info{% if section.settings.sticky_info %} product__info--sticky{% endif %}">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'text' %}
          {% if block.settings.text != blank %}
            {% if block.settings.style == 'eyebrow' %}
              <span class="product__eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
            {% else %}
              <p {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {% endif %}
          {% endif %}

        {% when 'title' %}
          <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

        {% when 'price' %}
          <div class="product__price" {{ block.shopify_attributes }}>
            {% render 'price', target: current_variant %}
          </div>

        {% when 'inventory' %}
          {%- comment -%}
            Low-stock messaging follows the global Shipping & delivery
            settings (ship_show_stock / ship_low_stock); the block's own
            threshold acts as a per-template override when changed.
          {%- endcomment -%}
          {%- liquid
            assign low_threshold = block.settings.low_stock_threshold | default: settings.ship_low_stock | default: 10
          -%}
          <div class="product__inventory" data-inventory-block {{ block.shopify_attributes }}>
            {%- if current_variant.available -%}
              {%- if settings.ship_show_stock and current_variant.inventory_management != blank and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= low_threshold -%}
                <span class="eyebrow">Only {{ current_variant.inventory_quantity }} left</span>
              {%- endif -%}
            {%- else -%}
              <span class="eyebrow eyebrow--muted">{{ 'products.product.sold_out' | t }}</span>
            {%- endif -%}
          </div>

        {% when 'variant_picker' %}
          {% unless product.has_only_default_variant %}
            <variant-picker data-url="{{ product.url }}" {{ block.shopify_attributes }}>
              <script type="application/json" data-variant-json>
                {{ product.variants | json }}
              </script>
              {% for option in product.options_with_values %}
                <fieldset class="option">
                  <legend class="option__head">
                    <span class="option__name">{{ option.name }}</span>
                    <span class="option__value" data-option-selected>{{ option.selected_value }}</span>
                  </legend>
                  <div class="option__list">
                    {% for value in option.values %}
                      <label class="option__label">
                        <input
                          type="radio"
                          class="option__input"
                          name="options[{{ option.name | escape }}]"
                          value="{{ value | escape }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <span>{{ value }}</span>
                      </label>
                    {% endfor %}
                  </div>
                </fieldset>
              {% endfor %}
            </variant-picker>
          {% endunless %}

        {% when 'buy_buttons' %}
          <product-form {{ block.shopify_attributes }}>
            {% form 'product', product %}
              <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
              <div class="product__buy-row" data-atc-anchor>
                {% if block.settings.show_quantity %}
                  <quantity-input class="qty">
                    <button type="button" class="qty__btn" data-qty-step="-1" aria-label="Decrease quantity">&minus;</button>
                    <input
                      type="number"
                      class="qty__input"
                      name="quantity"
                      value="1"
                      min="1"
                      aria-label="{{ 'products.product.quantity' | t }}"
                    >
                    <button type="button" class="qty__btn" data-qty-step="1" aria-label="Increase quantity">+</button>
                  </quantity-input>
                {% endif %}
                <button
                  type="submit"
                  class="btn btn--primary btn--full"
                  data-add-button
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  <span data-add-label>
                    {%- if current_variant.available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                </button>
              </div>
            {% endform %}
          </product-form>

        {% when 'description' %}
          {% if product.description != blank %}
            <div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
          {% endif %}

        {% when 'collapsible_tab' %}
          <div class="accordion" {{ block.shopify_attributes }}>
            <details class="accordion__item" {% if block.settings.open_default %}open{% endif %}>
              <summary class="accordion__summary">
                {{ block.settings.heading }}
                <span class="accordion__icon" aria-hidden="true"></span>
              </summary>
              <div class="accordion__content rte">{{ block.settings.content }}</div>
            </details>
          </div>

        {% when 'custom_liquid' %}
          <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

        {% when 'variant_gallery' %}
          <div data-variant-media-filter hidden {{ block.shopify_attributes }}></div>

        {% when 'specifications' %}
          <div class="product__specs" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}<h3 class="h4">{{ block.settings.heading }}</h3>{% endif %}
            <table class="specs-table">
              <tbody>
                {% if block.settings.show_vendor and product.vendor != blank %}
                  <tr><th scope="row">Brand</th><td>{{ product.vendor }}</td></tr>
                {% endif %}
                {% if block.settings.show_type and product.type != blank %}
                  <tr><th scope="row">Type</th><td>{{ product.type }}</td></tr>
                {% endif %}
                {% if block.settings.show_sku and current_variant.sku != blank %}
                  <tr><th scope="row">SKU</th><td>{{ current_variant.sku }}</td></tr>
                {% endif %}
                {% if block.settings.show_weight and current_variant.weight > 0 %}
                  <tr><th scope="row">Weight</th><td>{{ current_variant.weight | weight_with_unit }}</td></tr>
                {% endif %}
                {% for i in (1..4) %}
                  {%- liquid
                    assign label_key = 'label_' | append: i
                    assign field_key = 'metafield_' | append: i
                    assign row_label = block.settings[label_key]
                    assign row_field = block.settings[field_key]
                  -%}
                  {% if row_label != blank and row_field != blank %}
                    {%- assign parts = row_field | split: '.' -%}
                    {% if parts.size == 2 %}
                      {%- assign mf = product.metafields[parts[0]][parts[1]] -%}
                      {% if mf != blank %}
                        <tr><th scope="row">{{ row_label }}</th><td>{{ mf | metafield_text }}</td></tr>
                      {% endif %}
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </tbody>
            </table>
          </div>

        {% when 'reviews' %}
          <div class="product__reviews" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}<h3 class="h4">{{ block.settings.heading }}</h3>{% endif %}
            {%- assign rating_value = product.metafields.reviews.rating.value -%}
            {%- assign rating_count = product.metafields.reviews.rating_count.value -%}
            {% if rating_value %}
              {%- assign rating_rounded = rating_value.rating | times: 1 | round -%}
              <div class="product__rating" role="img" aria-label="Rated {{ rating_value.rating }} out of {{ rating_value.scale_max }} stars">
                {% for i in (1..5) %}<span class="star{% if i <= rating_rounded %} star--filled{% endif %}" aria-hidden="true">&#9733;</span>{% endfor %}
                <span class="product__rating-count">{{ rating_value.rating }}{% if rating_count %} &middot; {{ rating_count }} review{% if rating_count != 1 %}s{% endif %}{% endif %}</span>
              </div>
            {% elsif block.settings.show_judgeme != true %}
              <p class="product__rating-count">No reviews yet.</p>
            {% endif %}
            {% if block.settings.show_judgeme %}
              {%- comment -%}
                Renders only when the Judge.me app embed is enabled; the star
                fallback above still works without the app.
              {%- endcomment -%}
              <div class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}"></div>
            {% endif %}
          </div>
      {% endcase %}
    {% endfor %}

    {%- comment -%}
      Shipping & returns assurances from the global Shipping & delivery
      settings — same wiring as the cart page, so the promise a customer
      sees at the cart matches the one on the product.
    {%- endcomment -%}
    {%- if settings.ship_show_estimate or settings.ship_show_returns -%}
      <ul class="product__assurances" role="list">
        {%- if settings.ship_show_estimate and settings.ship_estimate_text != blank -%}
          <li>{% render 'icon', name: 'truck', size: 15 %}{{ settings.ship_estimate_text }}</li>
        {%- endif -%}
        {%- if settings.ship_show_returns and settings.ship_returns_text != blank -%}
          <li>{% render 'icon', name: 'shield', size: 15 %}{{ settings.ship_returns_text }}</li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>
  </div>
  </div>
</section>

{%- assign variant_filter_block = section.blocks | where: 'type', 'variant_gallery' | first -%}
{% if variant_filter_block %}
  <script>
    /* Variant media filter: gallery entries whose alt text starts with the
       prefix (default "#") are shown only while the matching option value is
       selected; untagged media always shows. Runs after theme.js's own
       variant handling via the bubbled change event. */
    (function () {
      var root = document.querySelector('[data-section-id="{{ section.id }}"]');
      if (!root) return;
      var picker = root.querySelector('variant-picker');
      var prefix = {{ variant_filter_block.settings.alt_prefix | default: '#' | json }};

      function selectedValues() {
        if (!picker) return [];
        return Array.from(picker.querySelectorAll('input[type="radio"]:checked, select'))
          .map(function (el) { return el.value.toLowerCase(); });
      }

      function apply() {
        var values = selectedValues();
        var entries = root.querySelectorAll('.gallery__slide, .gallery__thumb');
        entries.forEach(function (el) {
          var img = el.querySelector('img');
          var alt = (img && img.getAttribute('alt')) || el.getAttribute('aria-label') || '';
          if (alt.indexOf(prefix) !== 0) { el.hidden = false; return; }
          var tag = alt.slice(prefix.length).trim().toLowerCase();
          el.hidden = values.indexOf(tag) === -1;
        });
        var gallery = root.querySelector('media-gallery');
        var active = root.querySelector('.gallery__slide.is-active');
        if (gallery && active && active.hidden) {
          var firstVisible = root.querySelector('.gallery__slide:not([hidden])');
          if (firstVisible) gallery.selectByMediaId(firstVisible.dataset.mediaId);
        }
      }

      if (picker) {
        picker.addEventListener('change', function () { setTimeout(apply, 0); });
      }
      apply();
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Product main",
  "settings": [
    {
      "type": "checkbox",
      "id": "sticky_info",
      "label": "Sticky product details",
      "info": "Keeps the buy column in view while the gallery scrolls.",
      "default": true
    },
    {
      "type": "select",
      "id": "media_layout",
      "label": "Gallery thumbnails",
      "options": [
        { "value": "below", "label": "Below the media" },
        { "value": "left", "label": "Left column" },
        { "value": "none", "label": "Hidden" }
      ],
      "default": "below"
    },
    { "type": "header", "content": "Section layout" },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme",
      "info": "Follows the active design preset.",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "surface", "label": "Raised surface" },
        { "value": "raised", "label": "Raised (higher)" },
        { "value": "brand", "label": "Brand" },
        { "value": "accent", "label": "Accent tint" },
        { "value": "inverse", "label": "Inverse" }
      ], "default": "default" },
    { "type": "select", "id": "section_width", "label": "Content width",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "page", "label": "Page" },
        { "value": "wide", "label": "Wide" },
        { "value": "full", "label": "Full bleed" }
      ], "default": "page" },
    { "type": "range", "id": "padding_top", "label": "Top padding",
      "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding",
      "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Luxury home decor"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "eyebrow", "label": "Eyebrow" },
            { "value": "body", "label": "Body" }
          ],
          "default": "eyebrow"
        }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "inventory",
      "name": "Inventory status",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "low_stock_threshold",
          "label": "Low-stock warning below",
          "min": 1,
          "max": 20,
          "step": 1,
          "default": 10
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_quantity",
          "label": "Show quantity selector",
          "default": true
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Materials & care"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "checkbox",
          "id": "open_default",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid"
        }
      ]
    },
    {
      "type": "variant_gallery",
      "name": "Variant media filter",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows gallery media only for the selected variant. Tag media by starting its alt text with the prefix plus the option value — e.g. \"#Green\". Untagged media always shows."
        },
        {
          "type": "text",
          "id": "alt_prefix",
          "label": "Alt text prefix",
          "default": "#"
        }
      ]
    },
    {
      "type": "specifications",
      "name": "Specifications",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Specifications"
        },
        {
          "type": "checkbox",
          "id": "show_vendor",
          "label": "Show brand",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_type",
          "label": "Show product type",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_sku",
          "label": "Show SKU",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_weight",
          "label": "Show weight",
          "default": true
        },
        {
          "type": "header",
          "content": "Custom rows"
        },
        {
          "type": "paragraph",
          "content": "Each row shows a product metafield. Enter the metafield as namespace.key — e.g. custom.material. Rows with no value on a product are hidden."
        },
        { "type": "text", "id": "label_1", "label": "Row 1 label" },
        { "type": "text", "id": "metafield_1", "label": "Row 1 metafield", "info": "namespace.key" },
        { "type": "text", "id": "label_2", "label": "Row 2 label" },
        { "type": "text", "id": "metafield_2", "label": "Row 2 metafield", "info": "namespace.key" },
        { "type": "text", "id": "label_3", "label": "Row 3 label" },
        { "type": "text", "id": "metafield_3", "label": "Row 3 metafield", "info": "namespace.key" },
        { "type": "text", "id": "label_4", "label": "Row 4 label" },
        { "type": "text", "id": "metafield_4", "label": "Row 4 metafield", "info": "namespace.key" }
      ]
    },
    {
      "type": "reviews",
      "name": "Reviews",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Reviews"
        },
        {
          "type": "checkbox",
          "id": "show_judgeme",
          "label": "Show Judge.me widget",
          "info": "Renders the full review list when the Judge.me app is installed. Without the app, the block falls back to Shopify's native star-rating metafields.",
          "default": true
        }
      ]
    }
  ]
}
{% endschema %}
