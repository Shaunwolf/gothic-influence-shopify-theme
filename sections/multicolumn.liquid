<section {% render 'section-attrs', s: section.settings, id: section.id %}>
  <div class="section__inner">
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<div class="rte lede">{{ section.settings.subheading }}</div>{%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="cols cols--{{ section.settings.columns }}">
    {%- for block in section.blocks -%}
      <div class="col {% if section.settings.align == 'center' %}col--center{% endif %} reveal" {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}
          <div class="col__media {% if section.settings.image_shape == 'round' %}col__media--round{% endif %}">
            {{ block.settings.image | image_url: width: 800 | image_tag:
               loading: 'lazy', widths: '200,400,600,800',
               sizes: '(min-width: 990px) 25vw, 45vw',
               alt: block.settings.title }}
          </div>
        {%- elsif block.settings.icon != 'none' -%}
          <span class="col__icon">{% render 'icon', name: block.settings.icon, size: 30 %}</span>
        {%- endif -%}
        {%- if block.settings.title != blank -%}<h3 class="h4">{{ block.settings.title }}</h3>{%- endif -%}
        {%- if block.settings.text != blank -%}<div class="rte text-muted">{{ block.settings.text }}</div>{%- endif -%}
        {%- if block.settings.link_label != blank -%}
          <a href="{{ block.settings.link | default: '#' }}" class="link-quiet">{{ block.settings.link_label }}</a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  </div>
</section>

{% schema %}
{
  "name": "Multicolumn",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centred"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image shape",
      "options": [
        {
          "value": "rect",
          "label": "Rectangle"
        },
        {
          "value": "round",
          "label": "Circle"
        }
      ],
      "default": "rect"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Follows the active design preset.",
      "options": [
        {
          "value": "default",
          "label": "Page background"
        },
        {
          "value": "surface",
          "label": "Raised surface"
        },
        {
          "value": "raised",
          "label": "Raised (higher)"
        },
        {
          "value": "brand",
          "label": "Brand"
        },
        {
          "value": "accent",
          "label": "Accent tint"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full bleed"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon (used when no image)",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "truck",
              "label": "Shipping"
            },
            {
              "value": "shield",
              "label": "Guarantee"
            },
            {
              "value": "leaf",
              "label": "Sustainable"
            },
            {
              "value": "gift",
              "label": "Gifting"
            },
            {
              "value": "star",
              "label": "Rated"
            }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Column"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe a material, a process, or a promise.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
