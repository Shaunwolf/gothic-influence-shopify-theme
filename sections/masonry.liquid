<style>
  .masonry-section .section-title {
    text-align: center;
    margin-bottom: var(--sp-2, 0.5rem);
  }

  .masonry-section .section-subtitle {
    text-align: center;
    color: var(--color-text-muted);
    margin: 0 auto var(--sp-6, 2rem);
    max-width: 60ch;
  }

  .masonry {
    columns: var(--masonry-cols, 3);
    column-gap: var(--masonry-gap, 16px);
  }

  .masonry__item {
    position: relative;
    display: block;
    break-inside: avoid;
    margin-bottom: var(--masonry-gap, 16px);
    border-radius: var(--radius-sm, 4px);
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }

  .masonry__item img,
  .masonry__item svg {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.5s var(--ease-out, ease);
  }

  .masonry__item:hover img {
    transform: scale(1.03);
  }

  /* Caption sits on a dark photo scrim, so it stays light in every design
     preset — see DESIGN-SYSTEM.md section 3. */
  .masonry__caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--sp-6, 2rem) var(--sp-4, 1rem) var(--sp-4, 1rem);
    background: linear-gradient(to top, rgb(0 0 0 / 0.65), transparent);
    color: rgb(255 255 255 / 0.95);
    font-family: var(--font-body);
    font-size: var(--fs-sm, 0.85rem);
    letter-spacing: var(--track-caps, 0.18em);
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .masonry__item:hover .masonry__caption,
  .masonry__item:focus-visible .masonry__caption {
    opacity: 1;
  }

  .masonry--captions-always .masonry__caption {
    opacity: 1;
  }

  @media (max-width: 1024px) {
    .masonry { columns: 2; }
  }

  @media (max-width: 600px) {
    .masonry { columns: 1; }
  }
</style>

<section {% render 'section-attrs', s: section.settings, id: section.id, extra: 'masonry-section' %}>
  <div class="section__inner">
  {% if section.settings.heading != blank %}
    <h2 class="section-title">{{ section.settings.heading }}</h2>
  {% endif %}
  {% if section.settings.subheading != blank %}
    <p class="section-subtitle">{{ section.settings.subheading }}</p>
  {% endif %}

  <div
    class="masonry{% if section.settings.captions_always %} masonry--captions-always{% endif %}"
    style="--masonry-cols: {{ section.settings.columns }}; --masonry-gap: {{ section.settings.gap }}px;"
  >
    {% for block in section.blocks %}
      {%- liquid
        assign tag = 'div'
        if block.settings.link != blank
          assign tag = 'a'
        endif
      -%}
      <{{ tag }}
        {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
        class="masonry__item"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 900', alt: block.settings.caption }}
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        {% endif %}
        {% if block.settings.caption != blank %}
          <span class="masonry__caption">{{ block.settings.caption }}</span>
        {% endif %}
      </{{ tag }}>
    {% else %}
      {% for i in (1..6) %}
        <div class="masonry__item">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>
      {% endfor %}
    {% endfor %}
  </div>
  </div>
</section>

{% schema %}
{
  "name": "Masonry gallery",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gallery"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 4,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "captions_always",
      "label": "Always show captions",
      "info": "Off: captions appear on hover.",
      "default": false
    },
    { "type": "header", "content": "Section layout" },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme",
      "info": "Follows the active design preset.",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "surface", "label": "Raised surface" },
        { "value": "raised", "label": "Raised (higher)" },
        { "value": "brand", "label": "Brand" },
        { "value": "accent", "label": "Accent tint" },
        { "value": "inverse", "label": "Inverse" }
      ], "default": "default" },
    { "type": "select", "id": "section_width", "label": "Content width",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "page", "label": "Page" },
        { "value": "wide", "label": "Wide" },
        { "value": "full", "label": "Full bleed" }
      ], "default": "page" },
    { "type": "range", "id": "padding_top", "label": "Top padding",
      "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding",
      "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Masonry gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
