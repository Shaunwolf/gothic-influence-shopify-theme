<section {% render 'section-attrs', s: section.settings, id: section.id %}>
  <div class="section__inner">
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: '#' }}" class="link-quiet">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="logos {% if section.settings.scroll %}logos--marquee{% endif %}"
       style="--logo-height: {{ section.settings.logo_height }}px; --marquee-speed: {{ section.settings.speed }}s;">
    {%- if section.settings.scroll -%}<div class="logos__track">{%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.name }}
            {%- endif -%}
          </a>
        {%- else -%}
          <span {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.name }}
            {%- endif -%}
          </span>
        {%- endif -%}
      {%- endfor -%}
      {%- comment -%} Duplicated so the marquee can loop seamlessly. {%- endcomment -%}
      {%- if section.settings.scroll -%}
        {%- for block in section.blocks -%}
          <span aria-hidden="true">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: '' }}
            {%- endif -%}
          </span>
        {%- endfor -%}
      {%- endif -%}
    {%- if section.settings.scroll -%}</div>{%- endif -%}
  </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand logos",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "scroll",
      "label": "Scroll continuously",
      "info": "Pauses for visitors who ask their system to reduce motion.",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll duration",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "s",
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 24,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Follows the active design preset.",
      "options": [
        {
          "value": "default",
          "label": "Page background"
        },
        {
          "value": "surface",
          "label": "Raised surface"
        },
        {
          "value": "raised",
          "label": "Raised (higher)"
        },
        {
          "value": "brand",
          "label": "Brand"
        },
        {
          "value": "accent",
          "label": "Accent tint"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full bleed"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "info": "Used as alt text."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand logos",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}
