<style>
  .lantern-section {
    background-color: var(--color-bg, #0d0d0d);
    padding: var(--sp-8, 3rem) 0;
  }

  .lantern-section .section-title {
    text-align: center;
    margin-bottom: var(--sp-6, 2rem);
  }

  .lantern-grid-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 350px;
    gap: 16px;
    padding: 0 40px 40px;
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
  }

  .lantern-card {
    --mouse-x: 50%;
    --mouse-y: 50%;
    position: relative;
    display: block;
    background: var(--color-surface, #121513);
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .lantern-card:nth-child(6n + 1) {
    grid-column: span 2;
    grid-row: span 2;
  }

  .lantern-card:nth-child(6n + 4) {
    grid-row: span 2;
  }

  .lantern-card:nth-child(6n + 5) {
    grid-column: span 2;
  }

  .lantern-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      800px circle at var(--mouse-x) var(--mouse-y),
      rgba(198, 161, 91, 0.13),
      rgba(45, 106, 64, 0.15) 40%,
      transparent 80%
    );
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .lantern-grid-container:hover .lantern-card::before {
    opacity: 1;
  }

  .lantern-card-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .lantern-card:hover .lantern-card-image {
    opacity: 0.85;
    transform: scale(1.03);
  }

  .lantern-card .card-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    background: linear-gradient(to top, rgba(13, 13, 13, 0.85), transparent 55%);
  }

  .lantern-card .card-content h3 {
    font-family: var(--font-display, 'Playfair Display', serif);
    color: var(--color-text, #e8ebe9);
    margin: 0;
    font-size: 1.25rem;
  }

  .lantern-card .card-content .card-price {
    color: var(--color-accent, #c6a15b);
    font-family: var(--font-body, 'Poppins', sans-serif);
    font-size: 0.95rem;
    margin: 4px 0 0;
  }

  @media (max-width: 1024px) {
    .lantern-grid-container {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 300px;
    }

    .lantern-card:nth-child(6n + 1) {
      grid-column: span 2;
      grid-row: span 1;
    }

    .lantern-card:nth-child(6n + 4) {
      grid-row: span 1;
    }
  }

  @media (max-width: 600px) {
    .lantern-grid-container {
      grid-template-columns: 1fr;
      grid-auto-rows: 320px;
      padding: 0 16px 24px;
    }

    .lantern-card:nth-child(n) {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
</style>

{%- liquid
  assign grid_collection = section.settings.collection
  if grid_collection == blank
    assign grid_collection = collections['all']
  endif
-%}

<section class="lantern-section">
  {% if section.settings.heading != blank %}
    <h2 class="section-title">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="lantern-grid-container" id="LanternGrid-{{ section.id }}">
    {% for product in grid_collection.products limit: section.settings.product_limit %}
      <a href="{{ product.url }}" class="lantern-card">
        {% if product.featured_image %}
          {{ product.featured_image | image_url: width: 800 | image_tag: class: 'lantern-card-image', loading: 'lazy', alt: product.title }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'lantern-card-image' }}
        {% endif %}
        <div class="card-content">
          <h3>{{ product.title }}</h3>
          <p class="card-price">{{ product.price | money }}</p>
        </div>
      </a>
    {% else %}
      {% for i in (1..5) %}
        <div class="lantern-card">
          {{ 'product-1' | placeholder_svg_tag: 'lantern-card-image' }}
          <div class="card-content">
            <h3>Sample product</h3>
          </div>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</section>

<script>
  (function () {
    var grid = document.getElementById('LanternGrid-{{ section.id }}');
    if (!grid || window.matchMedia('(hover: none)').matches) return;
    var cards = grid.getElementsByClassName('lantern-card');
    grid.addEventListener('mousemove', function (e) {
      for (var i = 0; i < cards.length; i++) {
        var rect = cards[i].getBoundingClientRect();
        cards[i].style.setProperty('--mouse-x', (e.clientX - rect.left) + 'px');
        cards[i].style.setProperty('--mouse-y', (e.clientY - rect.top) + 'px');
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Lantern grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Number of products",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "Lantern grid"
    }
  ]
}
{% endschema %}
