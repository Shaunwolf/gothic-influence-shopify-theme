<style>
  .lantern-section {
    background-color: var(--color-bg);
    padding-top: var(--pt);
    padding-bottom: var(--pb);
  }

  .lantern-section .section-title {
    text-align: center;
    margin-bottom: var(--sp-2, 0.5rem);
  }

  .lantern-section .section-subtitle {
    text-align: center;
    color: var(--color-text-muted);
    margin: 0 auto var(--sp-6, 2rem);
    max-width: 60ch;
  }

  .lantern-grid-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: var(--row-height);
    gap: 16px;
    padding: 0 40px;
    max-width: var(--page-max, 1400px);
    margin: 0 auto;
    position: relative;
  }

  .lantern-card {
    --mouse-x: 50%;
    --mouse-y: 50%;
    position: relative;
    display: block;
    background: var(--color-surface);
    border-radius: var(--radius-sm, 4px);
    overflow: hidden;
    border: 1px solid var(--color-line);
  }

  .lantern-grid-container--asymmetric .lantern-card:nth-child(6n + 1) {
    grid-column: span 2;
    grid-row: span 2;
  }

  .lantern-grid-container--asymmetric .lantern-card:nth-child(6n + 4) {
    grid-row: span 2;
  }

  .lantern-grid-container--asymmetric .lantern-card:nth-child(6n + 5) {
    grid-column: span 2;
  }

  .lantern-grid-container--glow .lantern-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      800px circle at var(--mouse-x) var(--mouse-y),
      color-mix(in srgb, var(--glow-1) var(--glow-strength), transparent),
      color-mix(in srgb, var(--glow-2) var(--glow-strength), transparent) 40%,
      transparent 80%
    );
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .lantern-grid-container--glow:hover .lantern-card::before {
    opacity: 1;
  }

  .lantern-card-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: var(--card-img-opacity, 0.6);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .lantern-card:hover .lantern-card-image {
    opacity: calc(var(--card-img-opacity, 0.6) + 0.25);
    transform: scale(1.03);
  }

  .lantern-card .card-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    background: linear-gradient(to top, rgb(0 0 0 / 0.65), transparent 55%);
  }

  /* Captions sit on the dark photo scrim below, so they stay light in every
     design preset — see docs/DESIGN-SYSTEM.md section 3. */
  .lantern-card .card-content h3 {
    font-family: var(--font-display);
    color: rgb(255 255 255 / 0.95);
    margin: 0;
    font-size: 1.25rem;
  }

  .lantern-card .card-content .card-vendor {
    color: rgb(255 255 255 / 0.7);
    font-family: var(--font-body);
    font-size: var(--fs-xs, 0.75rem);
    letter-spacing: var(--track-caps, 0.18em);
    text-transform: uppercase;
    margin: 0 0 2px;
  }

  .lantern-card .card-content .card-price {
    color: var(--gold-200, #d9bc7e);
    font-family: var(--font-body);
    font-size: 0.95rem;
    margin: 4px 0 0;
  }

  .lantern-section__footer {
    text-align: center;
    margin-top: var(--sp-6, 2rem);
  }

  @media (max-width: 1024px) {
    .lantern-grid-container {
      grid-template-columns: repeat(2, 1fr);
    }

    .lantern-grid-container--asymmetric .lantern-card:nth-child(6n + 1) {
      grid-column: span 2;
      grid-row: span 1;
    }

    .lantern-grid-container--asymmetric .lantern-card:nth-child(6n + 4) {
      grid-row: span 1;
    }
  }

  @media (max-width: 600px) {
    .lantern-grid-container {
      grid-template-columns: 1fr;
      padding: 0 16px;
    }

    .lantern-grid-container--asymmetric .lantern-card:nth-child(n) {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
</style>

{%- liquid
  assign grid_collection = section.settings.collection
  if grid_collection == blank
    assign grid_collection = collections['all']
  endif
-%}

{%- liquid
  if section.settings.glow_follow_theme
    assign glow_1 = 'var(--color-accent)'
    assign glow_2 = 'var(--color-brand)'
  else
    assign glow_1 = section.settings.glow_color_1
    assign glow_2 = section.settings.glow_color_2
  endif
-%}
<section
  class="lantern-section"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --row-height: {{ section.settings.row_height }}px; --glow-1: {{ glow_1 }}; --glow-2: {{ glow_2 }}; --glow-strength: {{ section.settings.glow_strength }}%; --card-img-opacity: {{ section.settings.image_opacity | times: 0.01 }};"
>
  {% if section.settings.heading != blank %}
    <h2 class="section-title">{{ section.settings.heading }}</h2>
  {% endif %}
  {% if section.settings.subheading != blank %}
    <p class="section-subtitle">{{ section.settings.subheading }}</p>
  {% endif %}

  <div
    class="lantern-grid-container lantern-grid-container--{{ section.settings.layout }}{% if section.settings.enable_glow %} lantern-grid-container--glow{% endif %}"
    id="LanternGrid-{{ section.id }}"
  >
    {% for product in grid_collection.products limit: section.settings.product_limit %}
      <a href="{{ product.url }}" class="lantern-card">
        {% if product.featured_image %}
          {{ product.featured_image | image_url: width: 800 | image_tag: class: 'lantern-card-image', loading: 'lazy', alt: product.title }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'lantern-card-image' }}
        {% endif %}
        <div class="card-content">
          {% if section.settings.show_vendor and product.vendor != blank %}
            <p class="card-vendor">{{ product.vendor }}</p>
          {% endif %}
          <h3>{{ product.title }}</h3>
          {% if section.settings.show_price %}
            <p class="card-price">{{ product.price | money }}</p>
          {% endif %}
        </div>
      </a>
    {% else %}
      {% for i in (1..5) %}
        <div class="lantern-card">
          {{ 'product-1' | placeholder_svg_tag: 'lantern-card-image' }}
          <div class="card-content">
            <h3>Sample product</h3>
          </div>
        </div>
      {% endfor %}
    {% endfor %}
  </div>

  {% if section.settings.show_view_all and grid_collection != blank %}
    <div class="lantern-section__footer">
      <a href="{{ grid_collection.url }}" class="btn btn--ghost">{{ 'sections.collection.view_all' | t }}</a>
    </div>
  {% endif %}
</section>

<script>
  (function () {
    var grid = document.getElementById('LanternGrid-{{ section.id }}');
    if (!grid || window.matchMedia('(hover: none)').matches) return;
    var cards = grid.getElementsByClassName('lantern-card');
    grid.addEventListener('mousemove', function (e) {
      for (var i = 0; i < cards.length; i++) {
        var rect = cards[i].getBoundingClientRect();
        cards[i].style.setProperty('--mouse-x', (e.clientX - rect.left) + 'px');
        cards[i].style.setProperty('--mouse-y', (e.clientY - rect.top) + 'px');
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Lantern grid",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Number of products",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view-all button",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Grid style",
      "options": [
        { "value": "asymmetric", "label": "Asymmetric editorial" },
        { "value": "uniform", "label": "Uniform grid" }
      ],
      "default": "asymmetric"
    },
    {
      "type": "range",
      "id": "row_height",
      "label": "Row height",
      "min": 240,
      "max": 480,
      "step": 20,
      "unit": "px",
      "default": 350
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "range",
      "id": "image_opacity",
      "label": "Image dimming",
      "info": "Resting image opacity. Images brighten on hover.",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "header",
      "content": "Lantern glow"
    },
    {
      "type": "checkbox",
      "id": "enable_glow",
      "label": "Enable cursor glow",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "glow_follow_theme",
      "label": "Match theme colours",
      "info": "Uses the accent and brand colours, so the glow re-tints with design presets. Untick to pick custom glow colours below.",
      "default": true
    },
    {
      "type": "color",
      "id": "glow_color_1",
      "label": "Custom glow (inner)",
      "default": "#c6a15b"
    },
    {
      "type": "color",
      "id": "glow_color_2",
      "label": "Custom glow (outer)",
      "default": "#2d6a40"
    },
    {
      "type": "range",
      "id": "glow_strength",
      "label": "Glow strength",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 13
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Lantern grid"
    }
  ]
}
{% endschema %}
