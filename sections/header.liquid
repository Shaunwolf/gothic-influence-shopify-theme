{%- liquid
  assign menu = section.settings.menu
-%}

<header class="header" data-section-id="{{ section.id }}">
  <div class="page-width header__inner">

    {%- comment -%} Left: desktop nav / mobile burger {%- endcomment -%}
    <div class="header__left">
      <button type="button"
              class="icon-btn header__burger"
              data-drawer-open="MobileNav"
              aria-label="{{ 'sections.header.menu' | t }}">
        {% render 'icon', name: 'menu', size: 22 %}
      </button>

      <nav class="nav header__nav-desktop{% if settings.nav_finial %} nav--finial{% endif %}" aria-label="{{ 'sections.header.primary_navigation' | t }}">
        {%- for link in linklists[menu].links -%}
          <div class="nav__item">
            <a href="{{ link.url }}"
               class="nav__link"
               {% if link.current %}aria-current="page"{% endif %}>
              {{ link.title }}
            </a>

            {%- if link.links.size > 0 -%}
              <div class="mega">
                <div class="mega__grid">
                  {%- for child in link.links -%}
                    <div>
                      <p class="mega__heading">{{ child.title }}</p>
                      {%- if child.links.size > 0 -%}
                        <ul class="mega__list">
                          {%- for grandchild in child.links -%}
                            <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                          {%- endfor -%}
                        </ul>
                      {%- else -%}
                        <ul class="mega__list">
                          <li><a href="{{ child.url }}">{{ 'sections.header.view_all' | t }}</a></li>
                        </ul>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}

                  {%- comment -%}
                    Optional visual tile. Merchants assign an image + collection
                    per menu item through blocks, so a mega menu needs no app.
                  {%- endcomment -%}
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'mega_promo' and block.settings.menu_item == link.title -%}
                      <figure class="mega__promo" {{ block.shopify_attributes }}>
                        <a href="{{ block.settings.link }}">
                          {%- if block.settings.image -%}
                            {{
                              block.settings.image
                              | image_url: width: 480
                              | image_tag:
                                loading: 'lazy',
                                widths: '240,360,480',
                                sizes: '240px',
                                alt: block.settings.heading
                            }}
                          {%- endif -%}
                          <figcaption>{{ block.settings.heading }}</figcaption>
                        </a>
                      </figure>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </nav>
    </div>

    {%- comment -%} Centre: logo {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="header__logo">
      {%- if section.settings.logo -%}
        {{
          section.settings.logo
          | image_url: width: 480
          | image_tag:
            widths: '120,180,240,360,480',
            sizes: '200px',
            alt: shop.name,
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {%- else -%}
        <span class="header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    {%- comment -%} Right: search, account, cart {%- endcomment -%}
    <div class="header__actions">
      {%- if settings.search_enabled -%}
        <button type="button"
                class="icon-btn"
                data-drawer-open="SearchDrawer"
                aria-label="{{ 'general.search.search' | t }}">
          {% render 'icon', name: 'search', size: 20 %}
        </button>
      {%- endif -%}

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}"
           class="icon-btn hide-mobile"
           aria-label="{{ 'customer.account.title' | t }}">
          {% render 'icon', name: 'user', size: 20 %}
        </a>
      {%- endif -%}

      {%- if settings.grimoire_enable -%}
        <button type="button"
                class="icon-btn"
                data-drawer-open="GrimoireDrawer"
                aria-label="{{ settings.grimoire_heading | default: 'The Grimoire' }}">
          {% render 'icon', name: 'heart', size: 20 %}
          <span class="icon-btn__count" data-grimoire-count hidden>0</span>
        </button>
      {%- endif -%}

      {%- liquid
        assign cart_href = routes.cart_url
        if settings.cart_type == 'drawer'
          assign cart_href = '#'
        endif
      -%}
      <a href="{{ cart_href }}"
         class="icon-btn"
         {% if settings.cart_type == 'drawer' %}data-drawer-open="CartDrawer"{% endif %}
         aria-label="{{ 'sections.header.cart' | t }}">
        {% render 'icon', name: 'cart', size: 20 %}
        <span class="icon-btn__count"
              data-cart-count
              {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{%- comment -%} Mobile navigation drawer {%- endcomment -%}
<site-drawer id="MobileNav" class="drawer drawer--left{% if settings.drawer_arch %} drawer--arched{% endif %}" aria-hidden="true">
  <div class="drawer__scrim" data-drawer-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}">
    <div class="drawer__head">
      <span class="drawer__title">{{ 'sections.header.menu' | t }}</span>
      <button type="button" class="icon-btn" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon', name: 'close', size: 20 %}
      </button>
    </div>
    <div class="drawer__body">
      <ul class="mobile-nav">
        {%- for link in linklists[menu].links -%}
          <li>
            <a href="{{ link.url }}">{{ link.title }}</a>
            {%- if link.links.size > 0 -%}
              <ul class="mobile-nav__sub">
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
    {%- if shop.customer_accounts_enabled -%}
      <div class="drawer__foot">
        <a href="{{ routes.account_url }}" class="btn btn--ghost btn--full">
          {{ 'customer.account.title' | t }}
        </a>
      </div>
    {%- endif -%}
  </div>
</site-drawer>

{%- comment -%} Search drawer with predictive results {%- endcomment -%}
<site-drawer id="SearchDrawer" class="drawer{% if settings.drawer_arch %} drawer--arched{% endif %}" aria-hidden="true">
  <div class="drawer__scrim" data-drawer-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'general.search.search' | t }}">
    <div class="drawer__head">
      <span class="drawer__title">{{ 'general.search.search' | t }}</span>
      <button type="button" class="icon-btn" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon', name: 'close', size: 20 %}
      </button>
    </div>
    <div class="drawer__body">
      <predictive-search class="search-wrap"{% unless settings.search_predictive %} data-disabled="true"{% endunless %}>
        <form action="{{ routes.search_url }}" method="get" role="search">
          <label class="visually-hidden" for="SearchInput">{{ 'general.search.search' | t }}</label>
          <input type="search"
                 id="SearchInput"
                 name="q"
                 class="input"
                 placeholder="{{ 'general.search.placeholder' | t }}"
                 autocomplete="off"
                 spellcheck="false">
          <input type="hidden" name="options[prefix]" value="last">
        </form>
        <div class="search-panel" data-search-results hidden></div>
      </predictive-search>
    </div>
  </div>
</site-drawer>

{% schema %}
{
  "name": "Header",
  "class": "shopify-section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Transparent PNG or SVG. Falls back to the shop name as text."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Nested menu items become a mega menu automatically.",
      "default": "main-menu"
    }
  ],
  "blocks": [
    {
      "type": "mega_promo",
      "name": "Mega menu image",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Attach to menu item",
          "info": "Must match the top-level menu item title exactly."
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
