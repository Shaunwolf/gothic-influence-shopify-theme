<div class="section" data-section-id="{{ section.id }}">
  <div class="page-width page-width--narrow">
    <span class="eyebrow">{{ 'customer.account.title' | t }}</span>
    <h1>{{ 'customer.login.title' | t }}</h1>

    {% form 'customer_login', class: 'customer-form' %}
      {% if form.errors %}
        <p class="field__error">{{ form.errors | default_errors }}</p>
      {% endif %}
      <div class="field">
        <label class="field__label" for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
        <input type="email" class="input" id="CustomerEmail" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="field">
        <label class="field__label" for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
        <input type="password" class="input" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required>
      </div>
      <div class="customer-form__actions">
        <button type="submit" class="btn btn--primary">{{ 'customer.login.submit' | t }}</button>
        <a class="link" href="{{ routes.account_register_url }}">{{ 'customer.login.create' | t }}</a>
      </div>
    {% endform %}

    <details class="accordion__item">
      <summary class="accordion__summary">{{ 'customer.recover.title' | t }}</summary>
      <div class="accordion__content">
        <p>{{ 'customer.recover.subtext' | t }}</p>
        {% form 'recover_customer_password' %}
          {% if form.posted_successfully? %}
            <p class="form-success">{{ 'customer.recover.success' | t }}</p>
          {% endif %}
          {% if form.errors %}
            <p class="field__error">{{ form.errors | default_errors }}</p>
          {% endif %}
          <div class="field">
            <label class="field__label" for="RecoverEmail">{{ 'customer.login.email' | t }}</label>
            <input type="email" class="input" id="RecoverEmail" name="email" autocomplete="email" required>
          </div>
          <button type="submit" class="btn btn--ghost">{{ 'customer.recover.submit' | t }}</button>
        {% endform %}
      </div>
    </details>
  </div>
</div>

<style>
  .customer-form .field { margin-bottom: var(--sp-5); }
  .customer-form__actions { display: flex; align-items: center; gap: var(--sp-5); flex-wrap: wrap; margin-top: var(--sp-5); }
</style>

{% schema %}
{ "name": "Login", "settings": [] }
{% endschema %}
