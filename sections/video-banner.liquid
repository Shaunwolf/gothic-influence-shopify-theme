<section {% render 'section-attrs', s: section.settings, id: section.id %}>
  <div class="section__inner">

  {%- if section.settings.heading != blank -%}
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>
  {%- endif -%}

  <video-banner class="video-banner {% if section.settings.section_width == 'full' %}video-banner--full{% endif %}"
                style="--video-ratio: {{ section.settings.ratio }};">
    {%- if section.settings.video != blank -%}
      {%- comment -%}
        A native Shopify video. Autoplay implies muted and playsinline, or
        mobile browsers refuse to start it.
      {%- endcomment -%}
      {{ section.settings.video | video_tag:
         image_size: '1600x',
         autoplay: section.settings.autoplay,
         loop: section.settings.loop,
         muted: true,
         controls: section.settings.show_controls,
         playsinline: true }}
    {%- elsif section.settings.video_url != blank -%}
      {%- if section.settings.cover -%}
        <button type="button" class="video-banner__cover" data-video-play
                aria-label="{{ 'general.play_video' | t }}">
          {{ section.settings.cover | image_url: width: 2000 | image_tag:
             loading: 'lazy', widths: '750,1100,1500,2000', sizes: '100vw',
             alt: section.settings.heading }}
          <span class="video-banner__play">{% render 'icon', name: 'arrow-right', size: 26 %}</span>
        </button>
      {%- endif -%}
      <template data-video-embed>
        <iframe src="{{ section.settings.video_url.type }}{% if section.settings.video_url.type == 'youtube' %}{% endif %}"
                title="{{ section.settings.heading | escape }}"
                allow="autoplay; encrypted-media" allowfullscreen loading="lazy"></iframe>
      </template>
    {%- else -%}
      <div style="aspect-ratio: {{ section.settings.ratio }}; display: grid; place-items: center; background: var(--color-surface); border: 1px solid var(--color-line);">
        <span class="text-subtle">{{ 'general.no_video' | t }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.caption != blank -%}
      <div class="video-banner__caption">
        <p class="h3" style="color: #fff;">{{ section.settings.caption }}</p>
      </div>
    {%- endif -%}
  </video-banner>
  </div>
</section>

{% schema %}
{
  "name": "Video banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Uploaded to Shopify. Takes priority over an external URL."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "External video",
      "accept": [
        "youtube",
        "vimeo"
      ]
    },
    {
      "type": "image_picker",
      "id": "cover",
      "label": "Cover image",
      "info": "Shown before an external video loads, so nothing loads from YouTube until the visitor asks."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption over video"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Shape",
      "options": [
        {
          "value": "16/9",
          "label": "Widescreen"
        },
        {
          "value": "21/9",
          "label": "Cinematic"
        },
        {
          "value": "4/3",
          "label": "Classic"
        },
        {
          "value": "1/1",
          "label": "Square"
        }
      ],
      "default": "16/9"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "info": "Always muted \u2014 browsers block autoplay with sound.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show controls",
      "default": false
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Follows the active design preset.",
      "options": [
        {
          "value": "default",
          "label": "Page background"
        },
        {
          "value": "surface",
          "label": "Raised surface"
        },
        {
          "value": "raised",
          "label": "Raised (higher)"
        },
        {
          "value": "brand",
          "label": "Brand"
        },
        {
          "value": "accent",
          "label": "Accent tint"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full bleed"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Video banner"
    }
  ]
}
{% endschema %}
