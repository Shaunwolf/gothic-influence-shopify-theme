<div class="section {% if section.settings.surface %}color-brand-bg{% endif %}" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="text-center reveal" style="max-width: 620px; margin-inline: auto;">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 style="margin-top: var(--sp-3);">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte lede" style="margin: var(--sp-4) auto 0;">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- form 'customer', class: 'newsletter__form', style: 'margin: var(--sp-6) auto 0;' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'general.newsletter.email' | t }}</label>
        <input type="email"
               id="NewsletterEmail-{{ section.id }}"
               name="contact[email]"
               class="input"
               placeholder="{{ 'general.newsletter.placeholder' | t }}"
               autocomplete="email"
               required>
        <button type="submit" class="btn btn--gold">{{ 'general.newsletter.submit' | t }}</button>

        {%- if form.posted_successfully? -%}
          <p class="form-success">{{ 'general.newsletter.success' | t }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="field__error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The List" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "First look, quietly" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>New arrivals and private sales, before anyone else.</p>" },
    { "type": "checkbox", "id": "surface", "label": "Green background", "default": true }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
