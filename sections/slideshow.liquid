<section {% render 'section-attrs', s: section.settings, id: section.id %}>
  <div class="section__inner">

  <site-slideshow class="slideshow"
                  data-autoplay="{{ section.settings.autoplay }}"
                  data-speed="{{ section.settings.speed }}">
    <div class="slideshow__track">
      {%- for block in section.blocks -%}
        <div class="slideshow__slide {% if forloop.first %}is-active{% endif %}"
             data-slide="{{ forloop.index0 }}"
             role="group"
             aria-roledescription="slide"
             aria-label="{{ forloop.index }} of {{ section.blocks.size }}"
             {{ block.shopify_attributes }}>
          <div class="hero hero--{{ block.settings.align }}" style="--hero-h: {{ section.settings.height }}vh;">
            {%- if block.settings.image -%}
              <div class="hero__media">
                {{ block.settings.image | image_url: width: 3000 | image_tag:
                   loading: forloop.first, widths: '750,1100,1500,2000,3000',
                   sizes: '100vw', alt: block.settings.heading,
                   fetchpriority: forloop.first }}
              </div>
            {%- endif -%}
            <div class="hero__scrim"></div>
            <div class="page-width">
              <div class="hero__inner">
                {%- if block.settings.eyebrow != blank -%}
                  <span class="eyebrow">{{ block.settings.eyebrow }}</span>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="hero__title">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="lede" style="color: var(--color-text);">{{ block.settings.text }}</p>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <div class="hero__actions">
                    <a href="{{ block.settings.button_link | default: '#' }}" class="btn btn--primary">
                      {{ block.settings.button_label }}
                    </a>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <button type="button" class="slideshow__arrow slideshow__arrow--prev" data-slide-prev
              aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'chevron-down', size: 18 %}</button>
      <button type="button" class="slideshow__arrow slideshow__arrow--next" data-slide-next
              aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'chevron-down', size: 18 %}</button>
      <div class="slideshow__dots" role="tablist">
        {%- for block in section.blocks -%}
          <button type="button" class="slideshow__dot" role="tab"
                  data-slide-to="{{ forloop.index0 }}"
                  aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-label="{{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </site-slideshow>
  </div>
</section>

{% schema %}
{
  "name": "Slideshow",
  "settings": [
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 75
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Advance automatically",
      "info": "Stops for visitors who ask their system to reduce motion, and pauses on hover or focus.",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Seconds per slide",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Follows the active design preset.",
      "options": [
        {
          "value": "default",
          "label": "Page background"
        },
        {
          "value": "surface",
          "label": "Raised surface"
        },
        {
          "value": "raised",
          "label": "Raised (higher)"
        },
        {
          "value": "brand",
          "label": "Brand"
        },
        {
          "value": "accent",
          "label": "Accent tint"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full bleed"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Dark. Elegant. Enduring."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "align",
          "label": "Alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Centred"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
