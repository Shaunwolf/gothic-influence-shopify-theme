<section {% render 'section-attrs', s: section.settings, id: section.id %}>
  <div class="section__inner">
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<div class="rte lede">{{ section.settings.subheading }}</div>{%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="collage">
    {%- for block in section.blocks -%}
      {%- assign tag = 'div' -%}
      {%- if block.settings.link != blank -%}{%- assign tag = 'a' -%}{%- endif -%}
      <{{ tag }} class="collage__item collage__item--{{ block.settings.size }} reveal"
         {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}
          {{ block.settings.image | image_url: width: 1400 | image_tag:
             loading: 'lazy', widths: '400,700,1000,1400',
             sizes: '(min-width: 750px) 50vw, 90vw',
             alt: block.settings.caption }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
        {%- if block.settings.caption != blank -%}
          <span class="collage__caption">{{ block.settings.caption }}</span>
        {%- endif -%}
      </{{ tag }}>
    {%- endfor -%}
  </div>
  </div>
</section>

{% schema %}
{
  "name": "Image collage",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Follows the active design preset.",
      "options": [
        {
          "value": "default",
          "label": "Page background"
        },
        {
          "value": "surface",
          "label": "Raised surface"
        },
        {
          "value": "raised",
          "label": "Raised (higher)"
        },
        {
          "value": "brand",
          "label": "Brand"
        },
        {
          "value": "accent",
          "label": "Accent tint"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full bleed"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            {
              "value": "std",
              "label": "Standard"
            },
            {
              "value": "tall",
              "label": "Tall"
            },
            {
              "value": "wide",
              "label": "Wide"
            }
          ],
          "default": "std"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image collage",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "size": "tall"
          }
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image",
          "settings": {
            "size": "wide"
          }
        }
      ]
    }
  ]
}
{% endschema %}
