<div class="section section--loose" data-section-id="{{ section.id }}">
  <div class="page-width page-width--narrow">
    <div class="empty-state">
      <span class="eyebrow">{{ shop.name }}</span>
      <h1>{{ 'general.password_page.title' | t }}</h1>
      <p class="lede text-center">{{ 'general.password_page.subtext' | t }}</p>

      {% form 'storefront_password', class: 'customer-form' %}
        {% if form.errors %}
          <p class="field__error">{{ form.errors | default_errors }}</p>
        {% endif %}
        <div class="field">
          <label class="field__label" for="StorePassword">{{ 'general.password_page.password' | t }}</label>
          <input type="password" class="input" id="StorePassword" name="password" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn btn--primary">{{ 'general.password_page.submit' | t }}</button>
      {% endform %}
    </div>
  </div>
</div>

<style>
  .customer-form .field { margin-bottom: var(--sp-5); }
</style>

{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
