<section {% render 'section-attrs', s: section.settings, id: section.id %}>
  <div class="section__inner">
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: '#' }}" class="link-quiet">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- assign blog = blogs[section.settings.blog] -%}
  <div class="grid grid--{{ section.settings.columns }}">
    {%- for article in blog.articles limit: section.settings.count -%}
      <article class="card reveal">
        <a href="{{ article.url }}" class="card__media" style="display:block;" tabindex="-1" aria-hidden="true">
          {%- if article.image -%}
            {{ article.image | image_url: width: 800 | image_tag:
               loading: 'lazy', widths: '300,450,600,800',
               sizes: '(min-width: 990px) 30vw, 90vw',
               alt: article.title, class: 'card__img' }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'card__img' }}
          {%- endif -%}
        </a>
        <div class="card__body">
          {%- if section.settings.show_date -%}
            <span class="card__vendor">{{ article.published_at | date: format: 'date' }}</span>
          {%- endif -%}
          <h3 class="card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
          {%- if section.settings.show_excerpt -%}
            <p class="text-muted" style="font-size: var(--fs-sm);">
              {{ article.excerpt_or_content | strip_html | truncatewords: 20 }}
            </p>
          {%- endif -%}
        </div>
      </article>
    {%- else -%}
      {%- for i in (1..section.settings.count) -%}
        <article class="card">
          <div class="card__media">{{ 'image' | placeholder_svg_tag: 'card__img' }}</div>
          <div class="card__body"><h3 class="card__title">{{ 'blogs.article.journal' | t }}</h3></div>
        </article>
      {%- endfor -%}
    {%- endfor -%}
  </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "count",
      "label": "Posts",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "3"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Follows the active design preset.",
      "options": [
        {
          "value": "default",
          "label": "Page background"
        },
        {
          "value": "surface",
          "label": "Raised surface"
        },
        {
          "value": "raised",
          "label": "Raised (higher)"
        },
        {
          "value": "brand",
          "label": "Brand"
        },
        {
          "value": "accent",
          "label": "Accent tint"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full bleed"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Blog posts"
    }
  ]
}
{% endschema %}
