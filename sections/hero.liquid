<style>
  .hero {
    overflow: hidden;
    display: flex;
    align-items: center;
    background: linear-gradient(
      135deg,
      var(--color-bg) 0%,
      var(--color-surface) 50%,
      color-mix(in srgb, var(--color-brand) 30%, var(--color-bg)) 100%
    );
  }

  .hero--small { min-height: 40vh; }
  .hero--medium { min-height: 60vh; }
  .hero--large { min-height: 80vh; }
  .hero--full { min-height: 100vh; }

  .hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Scrims track the active colour scheme's ground via --scheme-bg (falls
     back to the page background), so scrim and text always flip together. */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--scheme-bg, var(--color-bg));
  }

  /* Second scrim concentrated behind the text block, so the photography
     stays open at the edges while the title always clears WCAG AA — even
     when the photo's tone runs opposite to the preset's scrim. Checked
     against both a black and a white photo at the weakest reachable stop
     (DESIGN-SYSTEM section 3). */
  .hero__text-scrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 70% 85% at var(--scrim-x, 50%) 50%,
      color-mix(in srgb, var(--scheme-bg, var(--color-bg)) 80%, transparent),
      color-mix(in srgb, var(--scheme-bg, var(--color-bg)) 60%, transparent) 55%,
      transparent 78%
    );
  }

  .hero--align-left .hero__text-scrim { --scrim-x: 22%; }
  .hero--align-center .hero__text-scrim { --scrim-x: 50%; }
  .hero--align-right .hero__text-scrim { --scrim-x: 78%; }

  .hero > .section__inner {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero--align-left > .section__inner { text-align: left; }
  .hero--align-center > .section__inner { text-align: center; }
  .hero--align-right > .section__inner { text-align: right; }

  .hero__eyebrow {
    display: block;
    color: var(--color-accent-text);
    font-family: var(--font-body, 'Poppins', sans-serif);
    font-size: var(--fs-sm, 0.85rem);
    letter-spacing: var(--track-caps, 0.18em);
    text-transform: uppercase;
    margin-bottom: var(--sp-4, 1rem);
  }

  .hero__title {
    font-family: var(--font-display, 'Playfair Display', serif);
    color: var(--color-text);
    margin-bottom: var(--sp-4, 1rem);
  }

  .hero__subheading {
    /* Full-opacity primary text: this is 16px normal text over a photo,
       so it needs the full 4.5:1 — dimming it via opacity or the muted
       token caps the achievable contrast. Hierarchy comes from the size
       gap to the title and the light weight, which cost nothing. */
    color: var(--color-text);
    font-weight: var(--fw-light, 300);
    max-width: 46ch;
    margin-bottom: var(--sp-6, 2rem);
  }

  .hero--align-center .hero__subheading { margin-left: auto; margin-right: auto; }
  .hero--align-right .hero__subheading { margin-left: auto; }

  .hero__ctas {
    display: flex;
    gap: var(--sp-4, 1rem);
    flex-wrap: wrap;
  }

  .hero--align-center .hero__ctas { justify-content: center; }
  .hero--align-right .hero__ctas { justify-content: flex-end; }
</style>

{%- liquid
  assign has_ctas = false
  if section.settings.button_label != blank or section.settings.button_2_label != blank
    assign has_ctas = true
  endif
  assign hero_classes = 'hero hero--' | append: section.settings.height | append: ' hero--align-' | append: section.settings.alignment
-%}

<section {% render 'section-attrs', s: section.settings, id: section.id, extra: hero_classes %}>
  {% if section.settings.background_image != blank %}
    {{ section.settings.background_image | image_url: width: 2400 | image_tag: class: 'hero__media', loading: 'eager', fetchpriority: 'high', alt: section.settings.heading }}
    <div class="hero__overlay" style="opacity: {{ section.settings.overlay_opacity | times: 0.01 }};"></div>
    <div class="hero__text-scrim" aria-hidden="true"></div>
  {% endif %}

  <div class="section__inner">
    {% if section.settings.eyebrow != blank %}
      <span class="hero__eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="hero__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if has_ctas %}
      <div class="hero__ctas">
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--{{ section.settings.button_style }}">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
        {% if section.settings.button_2_label != blank %}
          <a href="{{ section.settings.button_2_link | default: routes.collections_url }}" class="btn btn--{{ section.settings.button_2_style }}">
            {{ section.settings.button_2_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Falls back to the gradient when empty."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay",
      "info": "Base wash across the whole image. A second scrim automatically strengthens behind the text, so the photo can stay open at the edges. The minimum keeps long headlines readable on any photo.",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "height",
      "label": "Section height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Luxury home decor"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Elegance Reimagined"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Dark, sophisticated, and unmistakably gothic"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "First button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "First button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "First button style",
      "options": [
        { "value": "primary", "label": "Solid" },
        { "value": "ghost", "label": "Outline" },
        { "value": "gold", "label": "Gold" }
      ],
      "default": "primary"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Second button label"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Second button link"
    },
    {
      "type": "select",
      "id": "button_2_style",
      "label": "Second button style",
      "options": [
        { "value": "primary", "label": "Solid" },
        { "value": "ghost", "label": "Outline" },
        { "value": "gold", "label": "Gold" }
      ],
      "default": "ghost"
    },
    { "type": "header", "content": "Section layout" },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme",
      "info": "Follows the active design preset.",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "surface", "label": "Raised surface" },
        { "value": "raised", "label": "Raised (higher)" },
        { "value": "brand", "label": "Brand" },
        { "value": "accent", "label": "Accent tint" },
        { "value": "inverse", "label": "Inverse" }
      ], "default": "default" },
    { "type": "select", "id": "section_width", "label": "Content width",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "page", "label": "Page" },
        { "value": "wide", "label": "Wide" },
        { "value": "full", "label": "Full bleed" }
      ], "default": "page" },
    { "type": "range", "id": "padding_top", "label": "Top padding",
      "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding",
      "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
