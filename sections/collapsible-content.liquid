<section {% render 'section-attrs', s: section.settings, id: section.id %}>
  <div class="section__inner">
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<div class="rte lede">{{ section.settings.subheading }}</div>{%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="faq" style="max-width: 860px; {% if section.settings.section_width == 'narrow' %}{% else %}margin-inline: auto;{% endif %}">
    {%- for block in section.blocks -%}
      <details class="faq__item" {% if block.settings.open_default %}open{% endif %} {{ block.shopify_attributes }}>
        <summary class="faq__q">
          {{ block.settings.question }}
          <span class="faq__icon">{% render 'icon', name: 'plus', size: 18 %}</span>
        </summary>
        <div class="faq__a rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
  </div>
</section>

{% schema %}
{
  "name": "Collapsible content",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Follows the active design preset.",
      "options": [
        {
          "value": "default",
          "label": "Page background"
        },
        {
          "value": "surface",
          "label": "Raised surface"
        },
        {
          "value": "raised",
          "label": "Raised (higher)"
        },
        {
          "value": "brand",
          "label": "Brand"
        },
        {
          "value": "accent",
          "label": "Accent tint"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full bleed"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does delivery take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Orders are dispatched within two business days. Larger pieces are sent by pallet courier and take seven to ten days.</p>"
        },
        {
          "type": "checkbox",
          "id": "open_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collapsible content",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
