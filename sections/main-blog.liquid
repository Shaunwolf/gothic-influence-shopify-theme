{%- paginate blog.articles by 12 -%}
<div class="section" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="text-center" style="margin-bottom: var(--sp-8);">
      <span class="eyebrow">{{ 'blogs.article.journal' | t }}</span>
      <h1 style="margin-top: var(--sp-3);">{{ blog.title }}</h1>
    </div>

    <div class="grid grid--3">
      {%- for article in blog.articles -%}
        <article class="card reveal">
          <a href="{{ article.url }}" class="card__media" style="display: block;">
            {%- if article.image -%}
              {{
                article.image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  widths: '300,450,600,800',
                  sizes: '(min-width: 990px) 30vw, 92vw',
                  alt: article.title | escape,
                  class: 'card__img'
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'card__img' }}
            {%- endif -%}
          </a>
          <div class="card__body">
            <span class="card__vendor">{{ article.published_at | date: format: 'date' }}</span>
            <h2 class="card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p class="text-muted" style="font-size: var(--fs-sm);">
              {{ article.excerpt_or_content | strip_html | truncatewords: 22 }}
            </p>
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination' | t }}">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr;</a>{%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}">{{ part.title }}</a>
          {%- else -%}
            <span {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">&rarr;</a>{%- endif -%}
      </nav>
    {%- endif -%}
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
