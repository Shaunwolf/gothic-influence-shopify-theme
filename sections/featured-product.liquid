<section {% render 'section-attrs', s: section.settings, id: section.id %}>
  <div class="section__inner">

  {%- assign p = section.settings.product -%}
  <div class="split {% if section.settings.flip %}split--flip{% endif %}">
    <div class="split__media reveal">
      {%- if p.featured_media -%}
        {{ p.featured_media | image_url: width: 1200 | image_tag:
           loading: 'lazy', widths: '400,600,900,1200',
           sizes: '(min-width: 750px) 50vw, 92vw', alt: p.title }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>

    <div class="split__text reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ p.title | default: 'Featured piece' }}</h2>
      {% render 'price', target: p, show_unit: true %}

      {%- if section.settings.show_description and p.description != blank -%}
        <div class="rte text-muted">{{ p.description | strip_html | truncatewords: 40 }}</div>
      {%- endif -%}

      {%- if p != blank -%}
        <product-form>
          {%- form 'product', p, novalidate: 'novalidate' -%}
            <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}" data-variant-id>
            <input type="hidden" name="quantity" value="1">
            <div style="display:flex; gap: var(--sp-3); flex-wrap: wrap; margin-top: var(--sp-5);">
              <button type="submit" class="btn btn--primary" data-add-button
                      {% unless p.available %}disabled{% endunless %}>
                <span data-add-label>
                  {%- if p.available -%}{{ 'products.product.add_to_cart' | t }}
                  {%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                </span>
              </button>
              <a href="{{ p.url }}" class="btn btn--ghost">{{ 'products.product.view_details' | t }}</a>
            </div>
          {%- endform -%}
        </product-form>
      {%- endif -%}
    </div>
  </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Piece of the month"
    },
    {
      "type": "checkbox",
      "id": "flip",
      "label": "Image on the right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "info": "Follows the active design preset.",
      "options": [
        {
          "value": "default",
          "label": "Page background"
        },
        {
          "value": "surface",
          "label": "Raised surface"
        },
        {
          "value": "raised",
          "label": "Raised (higher)"
        },
        {
          "value": "brand",
          "label": "Brand"
        },
        {
          "value": "accent",
          "label": "Accent tint"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Content width",
      "options": [
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full bleed"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Featured product"
    }
  ]
}
{% endschema %}
