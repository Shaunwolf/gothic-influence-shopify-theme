<footer class="footer" data-section-id="{{ section.id }}">
  <div class="page-width">

    <div class="footer__grid">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- case block.type -%}

            {%- when 'brand' -%}
              {%- if block.settings.logo -%}
                {{
                  block.settings.logo
                  | image_url: width: 360
                  | image_tag:
                    loading: 'lazy',
                    widths: '180,270,360',
                    sizes: '180px',
                    alt: shop.name,
                    style: 'max-height:44px;width:auto;margin-bottom:var(--sp-4);'
                }}
              {%- else -%}
                <p class="header__logo-text" style="margin-bottom: var(--sp-4);">{{ shop.name }}</p>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="rte text-muted" style="font-size: var(--fs-sm);">{{ block.settings.text }}</div>
              {%- endif -%}

              {%- liquid
                assign has_social = false
                if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_pinterest != blank or settings.social_tiktok != blank or settings.social_youtube != blank
                  assign has_social = true
                endif
              -%}
              {%- if has_social -%}
                <div class="social" style="margin-top: var(--sp-5);">
                  {%- if settings.social_instagram != blank -%}
                    <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', name: 'instagram', size: 18 %}</a>
                  {%- endif -%}
                  {%- if settings.social_facebook != blank -%}
                    <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook', size: 18 %}</a>
                  {%- endif -%}
                  {%- if settings.social_pinterest != blank -%}
                    <a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">{% render 'icon', name: 'pinterest', size: 18 %}</a>
                  {%- endif -%}
                  {%- if settings.social_tiktok != blank -%}
                    <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', name: 'tiktok', size: 18 %}</a>
                  {%- endif -%}
                  {%- if settings.social_youtube != blank -%}
                    <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon', name: 'youtube', size: 18 %}</a>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'menu' -%}
              <p class="footer__heading">{{ block.settings.heading }}</p>
              <ul class="footer__list">
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>

            {%- when 'newsletter' -%}
              <p class="footer__heading">{{ block.settings.heading }}</p>
              {%- if block.settings.text != blank -%}
                <div class="rte text-muted" style="font-size: var(--fs-sm); margin-bottom: var(--sp-4);">
                  {{ block.settings.text }}
                </div>
              {%- endif -%}

              {%- form 'customer', class: 'newsletter__form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="visually-hidden" for="FooterEmail">{{ 'general.newsletter.email' | t }}</label>
                <input type="email"
                       id="FooterEmail"
                       name="contact[email]"
                       class="input"
                       placeholder="{{ 'general.newsletter.placeholder' | t }}"
                       autocomplete="email"
                       required>
                <button type="submit" class="btn btn--gold">{{ 'general.newsletter.submit' | t }}</button>

                {%- if form.posted_successfully? -%}
                  <p class="form-success">{{ 'general.newsletter.success' | t }}</p>
                {%- endif -%}
                {%- if form.errors -%}
                  <p class="field__error">{{ form.errors | default_errors }}</p>
                {%- endif -%}
              {%- endform -%}

          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <p>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.
        {%- if section.settings.show_policy_links -%}
          {%- for policy in shop.policies -%}
            {%- if policy != blank %} &middot; <a href="{{ policy.url }}" style="color: inherit;">{{ policy.title }}</a>{% endif -%}
          {%- endfor -%}
        {%- endif -%}
      </p>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="payment-icons" role="list" aria-label="{{ 'sections.footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <span role="listitem">{{ type | payment_type_svg_tag: class: 'payment-icon' }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show store policy links",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Considered pieces for rooms with a darker disposition.</p>"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "The List" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>New arrivals and private sales. No noise.</p>"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "brand" },
      { "type": "menu" },
      { "type": "newsletter" }
    ]
  },
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
