<div class="section section--loose" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="empty-state">
      <span class="eyebrow">{{ 'general.404.code' | t }}</span>
      <h1>{{ 'general.404.title' | t }}</h1>
      <p class="lede text-center">{{ 'general.404.subtext' | t }}</p>
      <div style="display:flex; gap: var(--sp-3); flex-wrap: wrap; justify-content: center;">
        <a href="{{ routes.root_url }}" class="btn btn--primary">{{ 'general.404.home' | t }}</a>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--ghost">{{ 'general.continue_shopping' | t }}</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{ "name": "404", "settings": [] }
{% endschema %}
