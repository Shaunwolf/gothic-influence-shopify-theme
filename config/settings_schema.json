    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube"
      }
    ]
  },
  {
    "name": "Search engines & sharing",
    "settings": [
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Default sharing image",
        "info": "1200 x 630px. Used when a page has no image of its own."
      },
      {
        "type": "checkbox",
        "id": "enable_structured_data",
        "label": "Output product structured data",
        "info": "Lets Google show price, availability and ratings in results.",
        "default": true
      }
    ]
  },
  {
    "name": "Motion",
    "settings": [
      {
        "type": "paragraph",
        "content": "Every animation here is automatically disabled for visitors who ask their system to reduce motion."
      },
      {
        "type": "checkbox",
        "id": "enable_reveal",
        "label": "Fade sections in on scroll",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_image_zoom",
        "label": "Zoom product images on hover",
        "default": true
      },
      {
        "type": "header",
        "content": "Scrolling"
      },
      {
        "type": "checkbox",
        "id": "smooth_scroll",
        "label": "Momentum scrolling",
        "info": "Eases the page toward the scroll position instead of snapping. Native scrolling still drives it, so anchors and find-in-page keep working. Off automatically under reduced motion.",
        "default": true
      },
      {
        "type": "range",
        "id": "smooth_scroll_strength",
        "label": "Momentum",
        "min": 1,
        "max": 9,
        "step": 1,
        "default": 5
      }
    ]
  },
  {
    "name": "Buttons",
    "settings": [
      {
        "type": "paragraph",
        "content": "Applies to every button in the theme. The wipe is the fill sweeping up on hover rather than swapping colour — it reads considered instead of abrupt."
      },
      {
        "type": "select",
        "id": "button_radius",
        "label": "Corner style",
        "options": [
          {
            "value": "auto",
            "label": "Auto — follow the design preset"
          },
          {
            "value": "0px",
            "label": "Square"
          },
          {
            "value": "2px",
            "label": "Near-sharp (recommended)"
          },
          {
            "value": "6px",
            "label": "Soft"
          },
          {
            "value": "999px",
            "label": "Pill"
          }
        ],
        "default": "auto"
      },
      {
        "type": "checkbox",
        "id": "button_uppercase",
        "label": "Uppercase labels",
        "default": true
      },
      {
        "type": "range",
        "id": "button_tracking",
        "label": "Label letter spacing",
        "min": 0,
        "max": 30,
        "step": 2,
        "default": 0,
        "info": "Set to 0 to follow the design preset."
      },
      {
        "type": "checkbox",
        "id": "button_wipe",
        "label": "Wipe fill on hover",
        "default": true
      },
      {
        "type": "range",
        "id": "button_height",
        "label": "Height",
        "min": 40,
        "max": 64,
        "step": 2,
        "unit": "px",
        "default": 48
      }
    ]
  },
  {
    "name": "Colour swatches",
    "settings": [
      {
        "type": "paragraph",
        "content": "Swatches read the option named below. Give each colour a matching swatch image in Files, or name values after real CSS colours so they render without one."
      },
      {
        "type": "text",
        "id": "swatch_option_names",
        "label": "Option names",
        "info": "Comma separated, e.g. Color, Colour, Finish.",
        "default": "Color, Colour, Finish"
      },
      {
        "type": "select",
        "id": "swatch_shape",
        "label": "Shape",
        "options": [
          {
            "value": "circle",
            "label": "Circle"
          },
          {
            "value": "square",
            "label": "Square"
          }
        ],
        "default": "circle"
      },
      {
        "type": "range",
        "id": "swatch_size",
        "label": "Size",
        "min": 16,
        "max": 48,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "swatch_max",
        "label": "Maximum shown on a card",
        "min": 3,
        "max": 10,
        "step": 1,
        "default": 5
      }
    ]
  },
