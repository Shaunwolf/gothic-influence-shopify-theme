        "default": true
      },
      {
        "type": "checkbox",
        "id": "search_show_products",
        "label": "Suggest products",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "search_show_collections",
        "label": "Suggest collections",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "search_show_pages",
        "label": "Suggest pages",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "search_show_articles",
