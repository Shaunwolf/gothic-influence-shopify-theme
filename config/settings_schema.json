  {
    "name": "Badges",
    "settings": [
      {
        "type": "checkbox",
        "id": "badge_sale",
        "label": "Show sale badge",
        "default": true
      },
      {
        "type": "select",
        "id": "badge_sale_style",
        "label": "Sale badge shows",
        "options": [
          {
            "value": "percent",
            "label": "Percentage saved"
          },
          {
            "value": "amount",
            "label": "Amount saved"
          },
          {
            "value": "word",
            "label": "The word Sale"
          }
        ],
        "default": "percent"
      },
      {
        "type": "checkbox",
        "id": "badge_sold_out",
        "label": "Show sold-out badge",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "badge_new",
        "label": "Show 'new in' badge",
        "default": false
      },
      {
        "type": "range",
        "id": "badge_new_days",
