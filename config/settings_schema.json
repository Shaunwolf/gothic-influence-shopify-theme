        "default": 28
      },
      {
        "type": "text",
        "id": "badge_custom_tag",
        "label": "Custom badge from tag",
        "info": "Products carrying this tag show a badge with the tag name. Leave blank to disable."
      }
    ]
  },
  {
    "name": "Shipping & delivery",
    "settings": [
      {
        "type": "paragraph",
        "content": "Shown on product pages and in the cart. Keep it concrete — vague promises read as filler, and specifics reduce the questions your inbox gets."
      },
      {
        "type": "checkbox",
        "id": "ship_show_estimate",
        "label": "Show delivery estimate on product pages",
        "default": true
      },
      {
        "type": "text",
        "id": "ship_estimate_text",
        "label": "Estimate",
        "default": "Dispatched within 2 business days"
      },
      {
        "type": "checkbox",
        "id": "ship_show_returns",
        "label": "Show returns note",
        "default": true
      },
      {
        "type": "text",
        "id": "ship_returns_text",
        "label": "Returns note",
        "default": "30-day returns on unused pieces"
      },
      {
        "type": "checkbox",
        "id": "ship_show_stock",
        "label": "Show low-stock warning",
        "default": true
      },
      {
        "type": "range",
        "id": "ship_low_stock",
        "label": "Warn at or below",
        "min": 1,
        "max": 25,
        "step": 1,
        "default": 8
      }
    ]
  },
  {
    "name": "Checkout",
    "settings": [
      {
        "type": "paragraph",
        "content": "Checkout itself is styled in Shopify admin under Settings, Checkout. These control what the theme shows on the way there."
      },
      {
        "type": "checkbox",
        "id": "checkout_dynamic_buttons",
        "label": "Show accelerated checkout buttons",
        "info": "Shop Pay, PayPal and similar, beneath add to cart.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "checkout_show_payment_icons",
        "label": "Show payment icons in the cart",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "checkout_terms_required",
        "label": "Require agreeing to terms before checkout",
        "default": false
      },
      {
        "type": "url",
        "id": "checkout_terms_link",
        "label": "Terms page"
      }
    ]
  },
  {
    "name": "Newsletter popup",
    "settings": [
      {
        "type": "paragraph",
        "content": "Appears once per visitor and is remembered in their browser. It never reappears after a sign-up."
      },
      {
        "type": "checkbox",
        "id": "popup_enabled",
        "label": "Enable",
        "default": false
      },
      {
        "type": "range",
        "id": "popup_delay",
        "label": "Show after",
        "min": 0,
        "max": 60,
        "step": 5,
        "unit": "s",
        "default": 10
      },
      {
        "type": "range",
        "id": "popup_dismiss_days",
        "label": "Stay hidden for",
        "min": 1,
        "max": 90,
        "step": 1,
        "unit": "d",
        "default": 30
      },
      {
        "type": "image_picker",
        "id": "popup_image",
        "label": "Image"
      },
      {
        "type": "text",
        "id": "popup_heading",
        "label": "Heading",
        "default": "Ten percent, quietly"
      },
      {
        "type": "richtext",
        "id": "popup_text",
        "label": "Text",
        "default": "<p>Join the list for first look at new arrivals and private sales.</p>"
      },
      {
        "type": "text",
        "id": "popup_button",
        "label": "Button label",
        "default": "Subscribe"
      },
      {
        "type": "text",
        "id": "popup_dismiss",
        "label": "Dismiss label",
        "default": "No thanks"
      }
    ]
  },
  {
    "name": "Age verification",
    "settings": [
      {
        "type": "paragraph",
        "content": "Blocks the storefront until the visitor confirms. Only enable this if you genuinely need it — it costs traffic."
      },
      {
        "type": "checkbox",
        "id": "age_enabled",
        "label": "Enable",
        "default": false
      },
      {
        "type": "text",
        "id": "age_heading",
        "label": "Heading",
        "default": "Are you 18 or over?"
      },
      {
        "type": "richtext",
        "id": "age_text",
        "label": "Text",
        "default": "<p>You must confirm your age to enter this store.</p>"
