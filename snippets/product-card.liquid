{%- comment -%}
  Product card.
  Accepts: card_product, reveal (bool), index (int), ratio (string)

  Note on the click target: the whole card is clickable via a pseudo-element
  stretched from the title link, so the quick-add button inside stays its own
  separate control instead of being swallowed by a wrapping anchor.
{%- endcomment -%}

{%- liquid
  assign p = card_product
  assign has_alt = false
  if settings.card_hover_image and p.media.size > 1
    assign has_alt = true
  endif

  assign sold_out = false
  unless p.available
    assign sold_out = true
  endunless

  assign on_sale = false
  if p.compare_at_price > p.price
    assign on_sale = true
  endif

  comment
    Shape. Masked silhouettes clip any child, so badges and quick-add move
    below the image; card--shaped drives that, card--masked additionally
    suppresses the hairline outline, which a mask would cut mid-curve.
  endcomment
  assign shape = settings.card_shape | default: 'auto'
  if shape == 'auto'
    case settings.design_preset
      when 'onyx'
        assign shape = 'rect'
      when 'conservatory'
        assign shape = 'dome'
      when 'cathedral'
        assign shape = 'lancet'
      when 'porcelain'
        assign shape = 'oval'
      else
        assign shape = 'gothic'
    endcase
  endif
  if template.name == 'collection' and settings.card_shape_on_collection == false
    assign shape = 'rect'
  endif

  assign masked_shapes = 'gothic,lancet,keyhole,trefoil,scallop' | split: ','
  assign card_class = ''
  unless shape == 'rect'
    assign card_class = ' card--shaped'
    if masked_shapes contains shape
      assign card_class = card_class | append: ' card--masked'
    endif
  endunless
-%}

{%- if p == blank -%}
  <div class="card">
    <div class="card__media">{{ 'product-1' | placeholder_svg_tag: 'card__img' }}</div>
    <div class="card__body">
      <h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3>
      {% render 'price' %}
    </div>
  </div>
{%- else -%}
  <div class="card{{ card_class }} {% if reveal %}reveal{% endif %}"
       {% if ratio %}style="--card-ratio: {{ ratio }};"{% endif %}>
    {%- comment -%}
      Heart sits on .card, not inside .card__media — the masked silhouettes
      (gothic, lancet, keyhole, trefoil, scallop) clip media children.
    {%- endcomment -%}
    {%- if settings.grimoire_enable -%}
      <button type="button"
              class="grimoire-toggle"
              data-grimoire-toggle
              data-handle="{{ p.handle }}"
              aria-pressed="false"
              aria-label="{{ 'grimoire.save' | t }}">
        {% render 'icon', name: 'heart', size: 16 %}
      </button>
    {%- endif -%}
    <div class="card__media card__media--{{ shape }}">
      {%- if p.featured_media -%}
        {{
          p.featured_media
          | image_url: width: 800
          | image_tag:
            loading: 'lazy',
            widths: '200,300,400,500,600,700,800',
            sizes: '(min-width: 990px) 25vw, (min-width: 600px) 45vw, 90vw',
            alt: p.featured_media.alt | default: p.title,
            class: 'card__img card__img--main'
        }}
        {%- if has_alt -%}
          {{
            p.media[1]
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              widths: '200,300,400,500,600,700,800',
              sizes: '(min-width: 990px) 25vw, (min-width: 600px) 45vw, 90vw',
              alt: '',
              class: 'card__img card__img--alt'
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'card__img' }}
      {%- endif -%}

      {%- liquid
        comment
          Badge rules live here rather than in the markup so the conditions
          stay readable. Order matters: sold out outranks everything, then a
          merchant's custom tag, then sale, then new.
        endcomment
        assign show_badge = ''
        assign badge_text = ''
        assign badge_kind = 'plain'

        if settings.badge_sold_out and sold_out
          assign show_badge = 'yes'
          assign badge_text = 'products.product.sold_out' | t
          assign badge_kind = 'out'
        elsif settings.badge_custom_tag != blank and p.tags contains settings.badge_custom_tag
          assign show_badge = 'yes'
          assign badge_text = settings.badge_custom_tag
          assign badge_kind = 'sale'
        elsif settings.badge_sale and on_sale
          assign show_badge = 'yes'
          assign badge_kind = 'sale'
          case settings.badge_sale_style
            when 'amount'
              assign saved = p.compare_at_price | minus: p.price | money
              assign badge_text = 'products.product.save_amount' | t: amount: saved
            when 'word'
              assign badge_text = 'products.product.on_sale' | t
            else
              assign pct = p.compare_at_price | minus: p.price | times: 100.0 | divided_by: p.compare_at_price | round
              assign badge_text = 'products.product.save_percent' | t: percent: pct
          endcase
        elsif settings.badge_new
          comment
            Both sides have to be integers before minus. Chaining
            `| minus: p.created_at` hands minus a datetime, which coerces to 0,
            so age came out as the current epoch and the badge never showed.
          endcomment
          assign cutoff = settings.badge_new_days | times: 86400
          assign created_at_s = p.created_at | date: '%s' | plus: 0
          assign now_s = 'now' | date: '%s' | plus: 0
          assign age = now_s | minus: created_at_s
          if age < cutoff
            assign show_badge = 'yes'
            assign badge_text = 'products.product.new_in' | t
          endif
        endif
      -%}

      {%- if show_badge != blank -%}
        <div class="card__badges">
          <span class="badge badge--{{ badge_kind }}">{{ badge_text }}</span>
        </div>
      {%- endif -%}

      {%- if settings.card_quick_add and p.available -%}
        <div class="card__quick">
          {%- if p.variants.size == 1 -%}
            <quick-add data-variant-id="{{ p.selected_or_first_available_variant.id }}">
              <button type="button" class="btn btn--gold btn--sm btn--full">
                {{ 'products.product.quick_add' | t }}
              </button>
            </quick-add>
          {%- else -%}
            <a href="{{ p.url }}" class="btn btn--gold btn--sm btn--full" style="position: relative; z-index: 2;">
              {{ 'products.product.choose_options' | t }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="card__body">
      {%- if settings.card_show_vendor and p.vendor != blank -%}
        <span class="card__vendor">{{ p.vendor }}</span>
      {%- endif -%}

      <h3 class="card__title">
        <a href="{{ p.url }}">{{ p.title | escape }}</a>
      </h3>

      {% render 'price', target: p, show_unit: true %}

      {%- if settings.card_show_swatches -%}
        {%- assign swatch_names = settings.swatch_option_names | default: 'Color' | split: ',' -%}
        {%- for option in p.options_with_values -%}
          {%- liquid
            assign is_swatch = false
            for name in swatch_names
              assign trimmed = name | strip
              if option.name == trimmed
                assign is_swatch = true
              endif
            endfor
          -%}
          {%- if is_swatch -%}
            {%- assign cap = settings.swatch_max | default: 5 -%}
            <div class="swatches" role="list" aria-label="{{ option.name }}">
              {%- for value in option.values limit: cap -%}
                <span class="swatch"
                      role="listitem"
                      title="{{ value | escape }}"
                      style="background-color: {{ value | downcase | replace: ' ', '' }};"></span>
              {%- endfor -%}
              {%- if option.values.size > cap -%}
                <span class="swatch--more">+{{ option.values.size | minus: cap }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
