{% doc %}
  Shared SVG defs for the product image treatments. The arch clipPath uses
  objectBoundingBox units so it scales with any card size. Rendered from
  layout/theme.liquid only when the Cathedral treatment is active.
  @example
  {% render 'image-treatment-defs' %}
{% enddoc %}

{%- if settings.image_treatment == 'cathedral' -%}
  <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
    <defs>
      <clipPath id="gi-arch-clip" clipPathUnits="objectBoundingBox">
        <path d="M0 0.31 Q0 0.09 0.5 0.008 Q1 0.09 1 0.31 L1 1 L0 1 Z"/>
      </clipPath>
    </defs>
  </svg>
{%- endif -%}
