{% doc %}
  Shared SVG clipPaths for the image treatments, in objectBoundingBox units
  so they scale with any media box. Rendered from layout/theme.liquid only
  when a treatment that needs one is active.
  @example
  {% render 'image-treatment-defs' %}
{% enddoc %}

{%- assign clip_treatments = 'cathedral,keyhole,sail' | split: ',' -%}
{%- if clip_treatments contains settings.image_treatment -%}
  <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
    <defs>
      {%- case settings.image_treatment -%}
        {%- when 'cathedral' -%}
          <clipPath id="gi-arch-clip" clipPathUnits="objectBoundingBox">
            <path d="M0 0.31 Q0 0.09 0.5 0.008 Q1 0.09 1 0.31 L1 1 L0 1 Z"/>
          </clipPath>
        {%- when 'keyhole' -%}
          <clipPath id="gi-keyhole-clip" clipPathUnits="objectBoundingBox">
            <path d="M0.5 0.015 A0.34 0.262 0 0 1 0.84 0.277 A0.34 0.262 0 0 1 0.66 0.508 L0.84 0.985 L0.16 0.985 L0.34 0.508 A0.34 0.262 0 0 1 0.16 0.277 A0.34 0.262 0 0 1 0.5 0.015 Z"/>
          </clipPath>
        {%- when 'sail' -%}
          <clipPath id="gi-sail-clip" clipPathUnits="objectBoundingBox">
            <path d="M0.08 0.96 C 0.05 0.48 0.2 0.17 0.52 0.023 C 0.62 0.35 0.78 0.69 0.96 0.96 Z"/>
          </clipPath>
      {%- endcase -%}
    </defs>
  </svg>
{%- endif -%}
