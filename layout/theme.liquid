<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{% render 'design-tokens', output: 'bg' %}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- comment -%}
      Fonts are served from Shopify's own CDN via font_face, which is already
      preconnected above. That removes the render-blocking round trip to
      fonts.googleapis.com that a <link> stylesheet would add.
    {%- endcomment -%}
    {%- liquid
      assign body_font = settings.font_body
      assign body_bold = body_font | font_modify: 'weight', '600'
      assign body_italic = body_font | font_modify: 'style', 'italic'
      assign body_light = body_font | font_modify: 'weight', '300'
      assign display_font = settings.font_display
      assign display_italic = display_font | font_modify: 'style', 'italic'
      assign display_bold = display_font | font_modify: 'weight', '600'
    -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {%- if settings.image_treatment != 'none' and settings.image_treatment != blank -%}
      {{ 'image-treatments.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    <style>
      {{ body_font | font_face: font_display: 'swap' }}
      {{ body_bold | font_face: font_display: 'swap' }}
      {{ body_italic | font_face: font_display: 'swap' }}
      {{ body_light | font_face: font_display: 'swap' }}
      {{ display_font | font_face: font_display: 'swap' }}
      {{ display_italic | font_face: font_display: 'swap' }}
      {{ display_bold | font_face: font_display: 'swap' }}

      {% render 'design-tokens' %}

      h1, h2, h3, h4, .h1, .h2, .h3, .h4, .display, .hero__title {
        font-size: calc(var(--_fs, 1em) * var(--heading-scale));
      }
      .h1, h1 { --_fs: var(--fs-3xl); }
      .h2, h2 { --_fs: var(--fs-2xl); }
      .h3, h3 { --_fs: var(--fs-xl); }
      .h4, h4 { --_fs: var(--fs-lg); }
      .display, .hero__title { --_fs: var(--fs-4xl); }

      :root {
        --z-header: {{ settings.z_header }};
        --z-drawer: {{ settings.z_drawer }};
        --z-modal: {{ settings.z_modal }};
      }
      {%- comment -%}
        Buttons follow the preset tokens unless the merchant overrides them.
        Reading the Buttons group unconditionally is what made a preset change
        its colours but not its geometry.
      {%- endcomment -%}
      .btn {
        border-radius: {% if settings.button_radius == 'auto' %}var(--radius-sm){% else %}{{ settings.button_radius }}{% endif %};
        min-height: {{ settings.button_height }}px;
        letter-spacing: {% if settings.button_tracking == 0 %}var(--track-caps){% else %}{{ settings.button_tracking | times: 0.01 }}em{% endif %};
        text-transform: {% if settings.button_uppercase %}uppercase{% else %}none{% endif %};
      }
      {%- unless settings.button_wipe -%}
        .btn::after { display: none; }
        .btn:hover { background: var(--btn-hover-bg, var(--color-brand)); }
      {%- endunless -%}
      .swatch {
        width: {{ settings.swatch_size }}px;
        height: {{ settings.swatch_size }}px;
        border-radius: {% if settings.swatch_shape == 'square' %}var(--radius-sm){% else %}50%{% endif %};
      }

      {%- unless settings.enable_image_zoom -%}
        .card:hover .card__img { transform: none; }
      {%- endunless -%}
      {%- unless settings.enable_reveal -%}
        .reveal { opacity: 1; transform: none; animation: none; }
      {%- endunless -%}
    </style>


    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.Shopify = window.Shopify || {};
      window.Shopify.routes = window.Shopify.routes || {};
      window.Shopify.routes.root = {{ routes.root_url | append: '/' | replace: '//', '/' | json }};
      window.themeStrings = {
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        unavailable: {{ 'products.product.unavailable' | t | json }},
        cartError: {{ 'sections.cart.error' | t | json }},
        moneyFormat: {{ shop.money_format | json }},
        close: {{ 'accessibility.close' | t | json }},
        zoomLabel: {{ 'products.product.zoom_label' | t | json }},
        zoomHint: {{ 'products.product.zoom_hint' | t | json }}
      };
      window.themeConfig = {
        smoothScroll: {{ settings.smooth_scroll | json }},
        smoothScrollStrength: {{ settings.smooth_scroll_strength | json }},
        enableZoom: {{ settings.enable_zoom | json }}
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    {{ settings.custom_head }}
  </head>

  <body class="template-{{ template.name | handle }}{% if settings.image_treatment != 'none' and settings.image_treatment != blank %} treat-{{ settings.image_treatment }}{% endif %}"
        {%- if template.name == "product" %} data-product-handle="{{ product.handle }}"{% endif -%}>
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% render 'image-treatment-defs' %}

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    {% render 'popups' %}

    <ul hidden>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    {{ settings.custom_body }}
  </body>
</html>
