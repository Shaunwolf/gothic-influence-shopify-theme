<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }}</title>
    <meta name="description" content="{{ page_description | escape }}">

    {%- comment -%}
      Deliberately bare. The password page is the only thing a visitor can see
      before launch, so it carries the brand and nothing else — no header, no
      navigation, no cart. Same tokens as the storefront so the first
      impression matches what opens later.
    {%- endcomment -%}

    {%- liquid
      assign body_font = settings.font_body
      assign body_light = body_font | font_modify: 'weight', '300'
      assign display_font = settings.font_display
      assign display_italic = display_font | font_modify: 'style', 'italic'
    -%}
    <style>
      {{ body_font | font_face: font_display: 'swap' }}
      {{ body_light | font_face: font_display: 'swap' }}
      {{ display_font | font_face: font_display: 'swap' }}
      {{ display_italic | font_face: font_display: 'swap' }}

      :root {
        --color-bg: {{ settings.color_bg }};
        --color-surface: {{ settings.color_surface }};
        --color-line: {{ settings.color_line }};
        --color-line-strong: {{ settings.color_line | color_lighten: 8 }};
        --color-text: {{ settings.color_text }};
        --color-text-muted: {{ settings.color_text_muted }};
        --color-text-subtle: {{ settings.color_text_muted | color_darken: 12 }};
        --color-brand: {{ settings.color_brand }};
        --color-brand-text: {{ settings.color_brand_text }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-text: {{ settings.color_accent_text }};

        --gold-200: {{ settings.color_accent | color_lighten: 22 }};
        --gold-300: {{ settings.color_accent_text }};
        --gold-400: {{ settings.color_accent }};
        --gold-600: {{ settings.color_accent | color_darken: 16 }};

        --green-200: {{ settings.color_brand_text }};
        --green-400: {{ settings.color_brand }};
        --green-500: {{ settings.color_brand | color_darken: 8 }};
        --green-800: {{ settings.color_brand | color_darken: 26 }};

        --ink-700: {{ settings.color_surface | color_lighten: 3 }};
        --ink-800: {{ settings.color_surface }};
        --ink-900: {{ settings.color_bg }};

        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-display: {{ display_font.family }}, {{ display_font.fallback_families }};
        --fs-base: {{ settings.font_body_scale | times: 0.01 | times: 16 | round: 2 }}px;
        --track-caps: {{ settings.track_caps | times: 0.01 }}em;
        --radius-sm: {{ settings.corner_radius }};
      }

      .password-layout {
        min-height: 100vh;
        min-height: 100dvh;
        display: grid;
        grid-template-rows: 1fr auto;
        padding: var(--sp-6) var(--page-gutter);
        position: relative;
        isolation: isolate;
      }
      .password-layout::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: radial-gradient(120% 90% at 50% 0%, rgb(29 61 40 / 0.35), transparent 65%);
      }
      .password-main {
        display: grid;
        align-content: center;
        justify-items: center;
        text-align: center;
        gap: var(--sp-5);
        max-width: 520px;
        margin-inline: auto;
        width: 100%;
      }
      .password-foot {
        text-align: center;
        font-size: var(--fs-sm);
        color: var(--color-text-subtle);
        padding-top: var(--sp-6);
      }
      .password-foot a { color: var(--color-accent-text); }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.Shopify = window.Shopify || {};
      window.Shopify.routes = window.Shopify.routes || {};
      window.Shopify.routes.root = {{ routes.root_url | append: '/' | replace: '//', '/' | json }};
    </script>

    {{ content_for_header }}
  </head>

  <body class="template-password">
    <div class="password-layout">
      <main id="MainContent" role="main" tabindex="-1" class="password-main">
        {{ content_for_layout }}
      </main>

      <footer class="password-foot">
        {{ powered_by_link }}
      </footer>
    </div>
  </body>
</html>
