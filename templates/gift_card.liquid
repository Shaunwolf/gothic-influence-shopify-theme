{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_cards.issued.title' | t: shop: shop.name }}</title>
    <style>
      :root {
        --bg: #0b0c0b;
        --surface: #121513;
        --line: #262b27;
        --text: #e8ebe9;
        --muted: #949c96;
        --gold: #c6a15b;
        --gold-text: #d9bc7e;
        --green: #2d6a40;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Poppins', 'Segoe UI', sans-serif;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }
      .card {
        max-width: 480px;
        width: 100%;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 40px;
        text-align: center;
      }
      .eyebrow {
        color: var(--gold-text);
        font-size: 12px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        display: block;
        margin-bottom: 12px;
      }
      h1 { font-family: Georgia, 'Times New Roman', serif; font-weight: 700; margin-bottom: 8px; }
      .amount { font-size: 2.5rem; color: var(--gold); font-family: Georgia, serif; margin: 16px 0; }
      .code {
        display: inline-block;
        border: 1px dashed var(--gold);
        border-radius: 4px;
        padding: 14px 22px;
        font-size: 1.15rem;
        letter-spacing: 0.12em;
        margin: 16px 0 24px;
        user-select: all;
      }
      .note { color: var(--muted); font-size: 0.9rem; margin-bottom: 24px; }
      .actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
      .btn {
        display: inline-block;
        padding: 12px 22px;
        border-radius: 4px;
        text-decoration: none;
        font-size: 0.9rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        cursor: pointer;
        border: 1px solid var(--green);
        background: var(--green);
        color: var(--text);
        font-family: inherit;
      }
      .btn--ghost { background: transparent; border-color: var(--line); color: var(--text); }
      @media print {
        body { background: #fff; color: #000; }
        .card { border-color: #000; background: #fff; }
        .actions { display: none; }
        .eyebrow, .amount { color: #000; }
        .code { border-color: #000; }
        .note { color: #333; }
      }
    </style>
  </head>
  <body>
    <div class="card">
      <span class="eyebrow">{{ shop.name }}</span>
      <h1>{{ 'gift_cards.issued.subtext' | t }}</h1>

      <div class="amount">{{ gift_card.initial_value | money }}</div>

      {% if gift_card.enabled == false or gift_card.expired %}
        <p class="note">{{ 'gift_cards.issued.expired' | t }}</p>
      {% endif %}

      {% if gift_card.balance != gift_card.initial_value %}
        {%- assign gift_card_balance = gift_card.balance | money -%}
        <p class="note">{{ 'gift_cards.issued.remaining' | t: balance: gift_card_balance }}</p>
      {% endif %}

      <div class="code">{{ gift_card.code | format_code }}</div>
      <p class="note">{{ 'gift_cards.issued.redeem' | t }}</p>

      <div class="actions">
        <a class="btn" href="{{ shop.url }}" target="_blank" rel="noopener">{{ 'gift_cards.issued.shop_link' | t }}</a>
        <button class="btn btn--ghost" onclick="window.print();">{{ 'gift_cards.issued.print' | t }}</button>
      </div>
    </div>
  </body>
</html>
